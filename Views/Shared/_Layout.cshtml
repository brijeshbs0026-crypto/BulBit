<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - BulBit</title>

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <!-- ================= TOP NAVBAR ================= -->
        <header class="top-navbar">

            <div class="top-left">
                <div class="mobile-menu">☰</div>

                <a asp-controller="Dashboard"
                   asp-action="Index"
                   class="navbar-brand">

                    <span class="brand-icon">B</span>
                    <span>BulBit</span>

                </a>
            </div>

            <div class="top-center">

                

            </div>

            <div class="top-right">

                <button class="icon-button">☼</button>

                <div class="notification">
                    ♢
                    <span></span>
                </div>

                <div class="top-profile">

                    <div class="profile-avatar">
                        @((User.Identity?.Name ?? "U").Substring(0, 1).ToUpper())
                    </div>

                    <div class="profile-info">
                        <strong>@User.Identity?.Name</strong>
                        <small style="color: #6366f1; font-weight: 600;">@(User.IsInRole("Admin") ? "Administrator" : "Employee")</small>
                    </div>

                </div>

                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="logout-button">
                        Logout
                    </button>

                </form>

            </div>

        </header>


        <!-- ================= APPLICATION ================= -->

        <div class="application">

            <!-- ================= SIDEBAR ================= -->

            <aside class="sidebar">

                <div class="sidebar-brand">

                    <div class="sidebar-logo">
                        BB
                    </div>

                    <div>
                        <strong>BulBit</strong>
                        <small>Employee Management</small>
                    </div>

                </div>


                <div class="menu-heading">
                    MAIN MENU
                </div>


                <a asp-controller="Dashboard"
                   asp-action="Index"
                   class="menu-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" || ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">

                    <span>⌂</span>
                    <span>Dashboard</span>

                </a>


                <a asp-controller="Employee"
                   asp-action="Index"
                   class="menu-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Employee" ? "active" : "")">

                    <span>♙</span>
                    <span>Employees</span>

                </a>

                <a asp-controller="Task"
                   asp-action="Index"
                   class="menu-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Task" ? "active" : "")">

                    <span>✓</span>
                    <span>Tasks</span>

                </a>

                <a asp-controller="Attendance"
                   asp-action="Index"
                   class="menu-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Attendance" ? "active" : "")">

                    <span>◷</span>
                    <span>Attendance</span>
                </a>
@* 
                <a href="#" class="menu-item">
                    <span>▣</span>
                    <span>Leave Management</span>
                    <span class="menu-badge">3</span>
                </a> *@

                <a asp-controller="Calendar"
                   asp-action="Index"
                   class="menu-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Calendar" ? "active" : "")">
                    <span>□</span>
                    <span>Calendar</span>
                </a>


                <a asp-controller="Client"
                   asp-action="Index"
                   class="menu-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Client" ? "active" : "")">
                    <span>👥</span>
                    <span>Clients</span>
                </a>


               @*  <a href="#" class="menu-item">
                    <span>▥</span>
                    <span>Reports</span>
                </a>

                <a href="#" class="menu-item">
                    <span>⚑</span>
                    <span>Announcements</span>
                </a>
 *@

                <div class="sidebar-spacer"></div>


                <div class="sidebar-user">

                    <div class="sidebar-avatar">
                        @((User.Identity?.Name ?? "U").Substring(0, 1).ToUpper())
                    </div>

                    <div class="sidebar-user-info">
                        <strong>@User.Identity?.Name</strong>
                        <small style="color: #6366f1; font-weight: 600;">@(User.IsInRole("Admin") ? "Administrator" : "Employee")</small>
                    </div>

                    <span class="sidebar-more">•••</span>

                </div>

            </aside>


            <!-- ================= PAGE CONTENT ================= -->

            <main class="main-content">

                @if (TempData["SuccessMessage"] is string success)
                {
                    <div class="alert success">
                        @success
                    </div>
                }

                @if (TempData["ErrorMessage"] is string error)
                {
                    <div class="alert error">
                        @error
                    </div>
                }

                @RenderBody()

            </main>

        </div>
    }
    else
    {
        <!-- Login/Register pages -->

        <main class="public-content">

            @if (TempData["SuccessMessage"] is string success)
            {
                <div class="alert success">
                    @success
                </div>
            }

            @RenderBody()

        </main>
    }


    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>