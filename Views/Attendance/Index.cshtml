@using AuthMvcApp.Helpers
@model List<AuthMvcApp.Models.Attendance>
@{
    var currentEmployee =
        ViewBag.CurrentEmployee as AuthMvcApp.Models.Employee;
}


@{
    ViewData["Title"] = "Attendance";

    var today = TimeHelper.Today;

    var todayRecords = Model
        .Where(x => x.AttendanceDate.Date == today)
        .ToList();

    var present = todayRecords.Count(x => x.Status == "Present");
    var late = todayRecords.Count(x => x.Status == "Late");
    var absent = todayRecords.Count(x => x.Status == "Absent");
    var leave = 0;

    var currentEmployeeAttendance = currentEmployee == null
    ? null
    : todayRecords.FirstOrDefault(x =>
        x.EmployeeId == currentEmployee.Id);

    var total = present + late + absent + leave;

    var rate = total == 0
        ? 0
        : (present * 100 / total);
}

<div class="attendance-page">

    <div class="attendance-header">
        <div>
            <div class="eyebrow">TIME & ATTENDANCE</div>

            <h1>Attendance</h1>

            <p>Today's attendance overview (Indian Standard Time · IST).</p>
        </div>
    </div>


    <!-- TOP SECTION -->

    <div class="attendance-top">

        <div class="checkin-card">

            <div class="today-row">
                <div class="today-label">
                    TODAY
                </div>
                <div class="ist-live-indicator" title="Indian Standard Time">
                    <span class="live-pulse"></span>
                    <span id="liveIstClock">@TimeHelper.Now.ToString("hh:mm:ss tt")</span> IST
                </div>
            </div>

            <strong class="checkin-date-text">
                @TimeHelper.Now.ToString("dddd, MMMM dd, yyyy")
            </strong>

            <h2>
                @if (currentEmployeeAttendance == null)
                {
                    @:You haven't checked in yet
                }
                else if (currentEmployeeAttendance.CheckOut == null)
                {
                    @:You're currently checked in
                }
                else
                {
                    @:Your attendance is completed
                }
            </h2>

            <p>
                @if (currentEmployeeAttendance == null)
                {
                    @:Mark your attendance when you start your workday.
                }
                else if (currentEmployeeAttendance.CheckOut == null)
                {
                    @:Checked in at @(currentEmployeeAttendance.CheckIn?.ToString("hh:mm tt") ?? "—") IST. Remember to check out before leaving.
                }
                else
                {
                    @:Checked in at @(currentEmployeeAttendance.CheckIn?.ToString("hh:mm tt") ?? "—") · Checked out at @(currentEmployeeAttendance.CheckOut?.ToString("hh:mm tt") ?? "—") (@currentEmployeeAttendance.Hours hrs)
                }
            </p>


            @if (currentEmployeeAttendance == null)
            {
                <!-- CHECK IN -->

                <form asp-controller="Attendance"
                      asp-action="CheckIn"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="checkin-btn">
                        <svg class="btn-svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
                            <polyline points="10 17 15 12 10 7"></polyline>
                            <line x1="15" y1="12" x2="3" y2="12"></line>
                        </svg>
                        <span>Check In</span>
                    </button>

                </form>
            }
            else if (currentEmployeeAttendance.CheckOut == null)
            {
                <!-- CHECK OUT -->

                <form asp-controller="Attendance"
                      asp-action="CheckOut"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="checkout-btn">
                        <svg class="btn-svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                            <polyline points="16 17 21 12 16 7"></polyline>
                            <line x1="21" y1="12" x2="9" y2="12"></line>
                        </svg>
                        <span>Check Out</span>
                    </button>

                </form>
            }
            else
            {
                <span class="completed-attendance">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <span>Day Completed</span>
                </span>
            }

        </div>


        <!-- PRESENT -->

        <div class="attendance-stat">

            <span>✓</span>

            <small>
                Present<br />Days
            </small>

            <strong>
                @present
            </strong>

            <em>
                Today
            </em>

        </div>


        <!-- LATE -->

        <div class="attendance-stat">

            <span>◷</span>

            <small>
                Late<br />Days
            </small>

            <strong>
                @late
            </strong>

            <em>
                Today
            </em>

        </div>


        <!-- LEAVE -->

        <div class="attendance-stat">

            <span>▣</span>

            <small>
                Leave<br />Days
            </small>

            <strong>
                @leave
            </strong>

            <em>
                Today
            </em>

        </div>


        <!-- RATE -->

        <div class="attendance-stat">

            <span>%</span>

            <small>
                Attendance<br />Rate
            </small>

            <strong>
                @rate%
            </strong>

            <em>
                Today
            </em>

        </div>

    </div>


    <!-- SUMMARY -->

    <div class="attendance-summary">

        <div>
            <span>✓</span>

            <small>
                Present
            </small>

            <strong>
                @present
            </strong>
        </div>


        <div>
            <span>◷</span>

            <small>
                Late
            </small>

            <strong>
                @late
            </strong>
        </div>


        <div>
            <span>×</span>

            <small>
                Absent
            </small>

            <strong>
                @absent
            </strong>
        </div>


        <div>
            <span>▣</span>

            <small>
                On Leave
            </small>

            <strong>
                @leave
            </strong>
        </div>

    </div>


    <!-- TABLE -->

    <div class="attendance-table-card">

        <h2>
            Today's Attendance
        </h2>

        <p>
            @TimeHelper.Today.ToString("MMMM dd, yyyy")
        </p>


        <div class="table-wrap">

            <table>

                <thead>

                    <tr>
                        <th>Employee</th>
                        <th>Status</th>
                        <th>Check In (IST)</th>
                        <th>Check Out (IST)</th>
                        <th>Hours</th>
                    </tr>

                </thead>


                <tbody>

                    @foreach (var item in todayRecords)
                    {
                        <tr>

                            <td>
                                <strong>
                                    @(item.Employee?.FullName ?? "Unknown")
                                </strong>
                            </td>


                            <td>

                                <span class="attendance-status">
                                    @item.Status
                                </span>

                            </td>


                            <td>
                                @(item.CheckIn?.ToString("hh:mm tt") ?? "—")
                            </td>


                            <td>
                                @(item.CheckOut?.ToString("hh:mm tt") ?? "—")
                            </td>


                            <td>

                                @(item.Hours > 0
                                    ? $"{item.Hours:0.##} hrs"
                                    : "—")

                            </td>

                        </tr>
                    }


                    @if (!todayRecords.Any())
                    {
                        <tr>

                            <td colspan="5"
                                class="empty">

                                No attendance records for today.

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

@section Scripts {
    <script>
        // Live Indian Standard Time (IST) Clock
        function updateLiveIstClock() {
            const clockEl = document.getElementById('liveIstClock');
            if (!clockEl) return;
            // IST is UTC+5:30
            const now = new Date();
            const utcTime = now.getTime() + (now.getTimezoneOffset() * 60000);
            const istTime = new Date(utcTime + (3600000 * 5.5));
            let hours = istTime.getHours();
            const minutes = String(istTime.getMinutes()).padStart(2, '0');
            const seconds = String(istTime.getSeconds()).padStart(2, '0');
            const ampm = hours >= 12 ? 'PM' : 'AM';
            hours = hours % 12;
            hours = hours ? hours : 12; // 0 becomes 12
            const strHours = String(hours).padStart(2, '0');
            clockEl.textContent = `${strHours}:${minutes}:${seconds} ${ampm}`;
        }
        setInterval(updateLiveIstClock, 1000);
    </script>
}