@model AuthMvcApp.Models.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="dashboard-card" style="max-width: 650px; margin: 3rem auto; text-align: center; padding: 2.5rem 2rem;">
    <div style="font-size: 3rem; margin-bottom: 1rem;">⚠️</div>
    <h1 style="font-size: 1.75rem; margin-bottom: 0.5rem; color: #f87171;">An error occurred</h1>
    <p style="color: #94a3b8; font-size: 0.95rem; margin-bottom: 1.5rem;">
        An unexpected error occurred while processing your request. Please try again or contact the administrator if the problem persists.
    </p>

    @if (Model.ShowRequestId)
    {
        <div style="background: rgba(255, 255, 255, 0.05); padding: 0.75rem 1rem; border-radius: 8px; margin-bottom: 1.5rem; font-family: monospace; font-size: 0.85rem; color: #cbd5e1; word-break: break-all;">
            <strong>Request ID:</strong> <code>@Model.RequestId</code>
        </div>
    }

    <div style="display: flex; justify-content: center; gap: 1rem;">
        <a asp-controller="Dashboard" asp-action="Index" class="btn primary" style="padding: 0.75rem 1.5rem;">
            Return to Dashboard
        </a>
    </div>
</div>
