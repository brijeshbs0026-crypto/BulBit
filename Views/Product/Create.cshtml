@model ProductViewModel
@{
    ViewData["Title"] = "Add Product";
}
<div class="form-page">
    <div class="panel form-panel">
        <div class="page-heading compact"><div><div class="eyebrow">DATA ENTRY</div><h1>Add Product</h1><p>Submit data to SQL Server through the service and repository layers.</p></div></div>
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert error"></div>
            <label asp-for="Name"></label>
            <input asp-for="Name" class="input" placeholder="Product name" />
            <span asp-validation-for="Name" class="field-error"></span>
            <label asp-for="Description"></label>
            <textarea asp-for="Description" class="input" rows="4" placeholder="Description"></textarea>
            <span asp-validation-for="Description" class="field-error"></span>
            <label asp-for="Price"></label>
            <input asp-for="Price" class="input" type="number" step="0.01" />
            <span asp-validation-for="Price" class="field-error"></span>
            <div class="form-actions"><a class="btn" asp-action="Index">Cancel</a><button class="btn primary" type="submit">Save Product</button></div>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
