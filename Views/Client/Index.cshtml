
@model IEnumerable<AuthMvcApp.Models.Client>

@{
    ViewData["Title"] = "Clients";
}

<div class="client-page">

    <div class="client-header">

        <div>
            <div class="client-eyebrow">CLIENT MANAGEMENT</div>

            <h1>Clients</h1>

            <p>
                Manage client details and monthly content requirements.
            </p>
        </div>

        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="client-add-btn">
                <span>+</span>
                Add Client
            </a>
        }

    </div>


    @if (TempData["SuccessMessage"] != null)
    {
        <div class="client-alert success">
            @TempData["SuccessMessage"]
        </div>
    }


    <div class="client-card">

        <div class="client-card-header">

            <div>
                <h2>Client List</h2>

                <p>
                    View and manage your clients.
                </p>
            </div>

            <div class="client-count">
                @Model.Count() Clients
            </div>

        </div>


        @if (!Model.Any())
        {
            <div class="client-empty">

                <div class="client-empty-icon">
                    👥
                </div>

                <h3>No clients yet</h3>

                <p>
                    @(User.IsInRole("Admin") ? "Start by adding your first client." : "No clients have been added yet.")
                </p>

                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Create" class="client-add-btn">
                        + Add Client
                    </a>
                }

            </div>
        }
        else
        {
            <div class="client-table-wrapper">

                <table class="client-table">

                    <thead>
                        <tr>
                            <th>CLIENT</th>
                            <th>DESCRIPTION</th>
                            <th>REELS / MONTH</th>
                            <th>POSTS / MONTH</th>
                            <th>STORIES / MONTH</th>
                            <th>VIDEOS / MONTH</th>
                            @if (User.IsInRole("Admin"))
                            {
                                <th>ACTIONS</th>
                            }
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var client in Model)
                        {
                            <tr>

                                <td>
                                    <div class="client-info">

                                        <div class="client-avatar">
                                            @client.ClientName.Substring(0, 1).ToUpper()
                                        </div>

                                        <strong>
                                            @client.ClientName
                                        </strong>

                                    </div>
                                </td>

                                <td>
                                    <span class="client-description">
                                        @(string.IsNullOrWhiteSpace(client.Description)
                                                                        ? "—"
                                                                        : client.Description)
                            </span>
                        </td>

                                <td>
                                    <span class="client-number">
                                        @client.ReelsPerMonth
                                    </span>
                                </td>

                                <td>
                                    <span class="client-number">
                                        @client.PostsPerMonth
                                    </span>
                                </td>

                                <td>
                                    <span class="client-number">
                                        @client.StoriesPerMonth
                                    </span>
                                </td>

                                <td>
                                    <span class="client-number">
                                        @client.VideosPerMonth
                                    </span>
                                </td>

                                @if (User.IsInRole("Admin"))
                                {
                                    <td>

                                        <div class="client-actions">

                                            <a asp-action="Edit"
                                               asp-route-id="@client.Id"
                                               class="client-edit-btn">
                                                Edit
                                            </a>

                                            <form asp-action="Delete"
                                                  asp-route-id="@client.Id"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="client-delete-btn"
                                                        onclick="return confirm('Are you sure you want to delete this client?');">
                                                    Delete
                                                </button>

                                            </form>

                                        </div>

                                    </td>
                                }

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>
