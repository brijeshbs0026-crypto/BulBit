@model AuthMvcApp.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";

    var hour = DateTime.Now.Hour;
    var greeting =
        hour >= 5 && hour < 12 ? "Good morning" :
        hour >= 12 && hour < 17 ? "Good afternoon" :
        "Good evening";

    var completionPercent = Model.TotalTasks > 0
        ? (int)Math.Round((double)Model.CompletedTasks * 100 / Model.TotalTasks)
        : 0;

    var avatarClasses = new[] { "av-indigo", "av-emerald", "av-amber", "av-rose", "av-sky", "av-violet" };
}

<style>
    /* ============ TOKENS ============ */
    .dashboard-page {
      --d-bg: #f6f7fb;
      --d-card: #ffffff;
      --d-border: #e8eaf3;
      --d-text: #161a33;
      --d-muted: #6b7194;

      --indigo: #5b5bf0;   --indigo-soft: #ececff;
      --amber:  #f59e0b;   --amber-soft:  #fff4dc;
      --emerald:#10b981;   --emerald-soft:#dcf8ec;
      --rose:   #f43f5e;   --rose-soft:   #ffe4e9;
      --sky:    #0ea5e9;   --sky-soft:    #dff3fd;
      --violet: #8b5cf6;   --violet-soft: #efe7ff;

      --d-shadow: 0 1px 2px rgba(22, 26, 51, .04), 0 8px 24px rgba(22, 26, 51, .05);

      max-width: 1200px;
      margin: 0 auto;
      padding: 8px 4px 40px;
      color: var(--d-text);
    }

    /* Dark mode: works with data-theme="dark", .dark or body.dark-mode */
    [data-theme="dark"] .dashboard-page,
    .dark .dashboard-page,
    body.dark-mode .dashboard-page {
      --d-bg: #0f1224;
      --d-card: #171a30;
      --d-border: #262a48;
      --d-text: #eceffd;
      --d-muted: #9aa0c7;

      --indigo-soft: rgba(91, 91, 240, .18);
      --amber-soft: rgba(245, 158, 11, .16);
      --emerald-soft: rgba(16, 185, 129, .16);
      --rose-soft: rgba(244, 63, 94, .16);
      --sky-soft: rgba(14, 165, 233, .16);
      --violet-soft: rgba(139, 92, 246, .18);
      --d-shadow: 0 8px 24px rgba(0, 0, 0, .35);
    }

    /* Shared SVG icon style */
    .dashboard-page svg {
      width: 1em; height: 1em;
      fill: none; stroke: currentColor;
      stroke-width: 2; stroke-linecap: round; stroke-linejoin: round;
      flex-shrink: 0;
    }

    /* ============ HEADER ============ */
    .dashboard-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      flex-wrap: wrap;
      padding: 28px 32px;
      margin-bottom: 24px;
      border-radius: 20px;
      color: #fff;
      background:
        radial-gradient(circle at 90% 0%, rgba(255,255,255,.22), transparent 45%),
        linear-gradient(120deg, #4338ca 0%, #6d5cf5 55%, #8b5cf6 100%);
      box-shadow: 0 12px 30px rgba(91, 91, 240, .28);
    }

    .dashboard-date {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 5px 12px;
      margin-bottom: 12px;
      font-size: 13px;
      background: rgba(255,255,255,.16);
      border-radius: 999px;
    }

    .dashboard-header h1 {
      margin: 0 0 6px;
      font-size: 30px;
      font-weight: 700;
      letter-spacing: -.02em;
      color: #fff;
    }

    .dashboard-header p { margin: 0; opacity: .85; font-size: 15px; color: #fff; }

    .dashboard-header-actions { display: flex; gap: 10px; flex-wrap: wrap; }

    .btn-soft, .btn-primary-soft {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 10px 16px;
      font-size: 14px; font-weight: 600;
      border-radius: 12px;
      text-decoration: none;
      transition: transform .15s ease, background .15s ease;
    }
    .btn-soft { color: #fff; background: rgba(255,255,255,.16); }
    .btn-soft:hover { background: rgba(255,255,255,.26); color: #fff; }
    .btn-primary-soft { color: #4338ca; background: #fff; }
    .btn-primary-soft:hover { transform: translateY(-1px); color: #4338ca; }

    /* ============ STAT CARDS ============ */
    .dashboard-stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 20px;
      margin-bottom: 24px;
    }

    .dashboard-stat-card {
      position: relative;
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 22px;
      background: var(--d-card);
      border: 1px solid var(--d-border);
      border-radius: 18px;
      box-shadow: var(--d-shadow);
      overflow: hidden;
    }

    .dashboard-stat-card::before {
      content: "";
      position: absolute; left: 0; top: 18%; bottom: 18%;
      width: 4px; border-radius: 0 4px 4px 0;
      background: var(--accent);
    }

    .dashboard-stat-icon {
      display: grid; place-items: center;
      width: 54px; height: 54px;
      font-size: 26px;
      border-radius: 16px;
      color: var(--accent);
      background: var(--accent-soft);
    }

    .dashboard-stat-content span { display: block; font-size: 14px; color: var(--d-muted); }
    .dashboard-stat-content strong { display: block; font-size: 32px; line-height: 1.15; font-weight: 700; }

    .stat-indigo  { --accent: var(--indigo);  --accent-soft: var(--indigo-soft); }
    .stat-amber   { --accent: var(--amber);   --accent-soft: var(--amber-soft); }
    .stat-emerald { --accent: var(--emerald); --accent-soft: var(--emerald-soft); }

    /* ============ SECTIONS ============ */
    .dashboard-section {
      padding: 24px;
      margin-bottom: 24px;
      background: var(--d-card);
      border: 1px solid var(--d-border);
      border-radius: 18px;
      box-shadow: var(--d-shadow);
    }

    .dashboard-section-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 20px;
    }

    .section-title { display: flex; align-items: center; gap: 14px; }
    .section-title h2 { margin: 0; font-size: 18px; font-weight: 700; }
    .section-title p  { margin: 2px 0 0; font-size: 13px; color: var(--d-muted); }

    .section-icon {
      display: grid; place-items: center;
      width: 42px; height: 42px; font-size: 20px;
      border-radius: 12px;
    }
    .si-indigo { color: var(--indigo); background: var(--indigo-soft); }
    .si-amber  { color: var(--amber);  background: var(--amber-soft); }

    .section-link {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 8px 14px;
      font-size: 13px; font-weight: 600;
      color: var(--indigo);
      background: var(--indigo-soft);
      border-radius: 10px;
      text-decoration: none;
      transition: gap .15s ease;
    }
    .section-link:hover { gap: 10px; color: var(--indigo); }

    /* ============ TEAM ============ */
    .team-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 14px;
    }

    .team-member {
      display: flex;
      align-items: center;
      gap: 14px;
      min-width: 0;
      padding: 14px 16px;
      background: var(--d-bg);
      border: 1px solid var(--d-border);
      border-radius: 14px;
      transition: border-color .15s ease, box-shadow .15s ease;
    }
    .team-member:hover { border-color: var(--indigo); box-shadow: 0 6px 18px rgba(91,91,240,.12); }

    .team-avatar {
      display: grid; place-items: center;
      width: 44px; height: 44px;
      font-weight: 700; font-size: 17px;
      border-radius: 50%;
      flex-shrink: 0;
    }
    .av-indigo  { color: var(--indigo);  background: var(--indigo-soft); }
    .av-emerald { color: var(--emerald); background: var(--emerald-soft); }
    .av-amber   { color: var(--amber);   background: var(--amber-soft); }
    .av-rose    { color: var(--rose);    background: var(--rose-soft); }
    .av-sky     { color: var(--sky);     background: var(--sky-soft); }
    .av-violet  { color: var(--violet);  background: var(--violet-soft); }

    .team-info { flex: 1; min-width: 0; }
    .team-info strong {
      display: block; font-size: 15px;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .team-info span {
      display: inline-flex; align-items: center; gap: 6px;
      font-size: 13px; color: var(--d-muted);
    }

    .status-active {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 5px 12px;
      font-size: 12px; font-weight: 600;
      color: #059669;
      background: var(--emerald-soft);
      border-radius: 999px;
    }
    .status-dot {
      width: 7px; height: 7px; border-radius: 50%;
      background: var(--emerald);
      box-shadow: 0 0 0 3px rgba(16,185,129,.25);
    }

    .empty {
      grid-column: 1 / -1;
      display: flex; flex-direction: column; align-items: center; gap: 8px;
      padding: 32px; color: var(--d-muted);
    }
    .empty svg { font-size: 34px; }

    /* ============ TASK OVERVIEW ============ */
    .task-overview {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 16px;
    }

    .task-overview-item {
      display: flex; flex-direction: column; align-items: center;
      gap: 4px;
      padding: 20px;
      border-radius: 16px;
      background: var(--accent-soft);
    }
    .task-overview-item strong { font-size: 30px; line-height: 1.1; color: var(--d-text); }
    .task-overview-item > span:last-child { font-size: 14px; color: var(--d-muted); }

    .task-icon {
      display: grid; place-items: center;
      width: 40px; height: 40px; margin-bottom: 6px;
      font-size: 20px;
      color: #fff;
      background: var(--accent);
      border-radius: 12px;
    }

    .t-total    { --accent: var(--indigo);  --accent-soft: var(--indigo-soft); }
    .t-done     { --accent: var(--emerald); --accent-soft: var(--emerald-soft); }
    .t-progress { --accent: var(--amber);   --accent-soft: var(--amber-soft); }

    .task-progress { margin-top: 22px; }
    .task-progress-label {
      display: flex; justify-content: space-between;
      margin-bottom: 8px; font-size: 13px; color: var(--d-muted);
    }
    .task-progress-label strong { color: var(--d-text); }
    .task-progress-track { height: 10px; background: var(--d-bg); border-radius: 999px; overflow: hidden; }
    .task-progress-fill {
      height: 100%;
      background: linear-gradient(90deg, var(--emerald), #34d399);
      border-radius: 999px;
      transition: width .8s ease;
    }

    /* ============ RESPONSIVE ============ */
    @@media (max-width: 640px) {
      .dashboard-header { padding: 22px; }
      .dashboard-header h1 { font-size: 24px; }
      .team-grid { grid-template-columns: 1fr; }
    }

    @@media (prefers-reduced-motion: reduce) {
      .dashboard-page * { transition: none !important; }
    }
</style>

<div class="dashboard-page">

    <!-- HEADER -->
    <div class="dashboard-header">
        <div class="dashboard-header-text">
            <div class="dashboard-date" id="dashboardDate">
                <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="3" /><path d="M16 2v4M8 2v4M3 10h18" /></svg>
                @DateTime.Now.ToString("dddd, MMMM dd, yyyy")
            </div>
            <h1 id="dashboardGreeting" data-username="@Model.UserName">@greeting, @Model.UserName 👋</h1>
            <p>Here’s what’s happening with your team today.</p>
        </div>

        <div class="dashboard-header-actions">
            <a class="btn-soft" asp-controller="Task" asp-action="Index">
                <svg viewBox="0 0 24 24"><path d="M9 11l3 3L22 4" /><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" /></svg>
                Tasks
            </a>
            <a class="btn-primary-soft" asp-controller="Employee" asp-action="Index">
                <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" /></svg>
                View team
            </a>
        </div>
    </div>

    <!-- STAT CARDS -->
    <div class="dashboard-stats">

        <div class="dashboard-stat-card stat-indigo">
            <div class="dashboard-stat-icon">
                <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" /></svg>
            </div>
            <div class="dashboard-stat-content">
                <span>Total Employees</span>
                <strong>@Model.TotalEmployees</strong>
            </div>
        </div>

        <div class="dashboard-stat-card stat-amber">
            <div class="dashboard-stat-icon">
                <svg viewBox="0 0 24 24"><path d="M9 11l3 3L22 4" /><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" /></svg>
            </div>
            <div class="dashboard-stat-content">
                <span>Active Tasks</span>
                <strong>@Model.ActiveTasks</strong>
            </div>
        </div>

        <div class="dashboard-stat-card stat-emerald">
            <div class="dashboard-stat-icon">
                <svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M16 11l2 2 4-4" /></svg>
            </div>
            <div class="dashboard-stat-content">
                <span>Present Today</span>
                <strong>@Model.PresentToday</strong>
            </div>
        </div>

    </div>

    <!-- MY TEAM -->
    <div class="dashboard-section">
        <div class="dashboard-section-header">
            <div class="section-title">
                <span class="section-icon si-indigo">
                    <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" /></svg>
                </span>
                <div>
                    <h2>My Team</h2>
                    <p>Employee overview</p>
                </div>
            </div>
            <a class="section-link" asp-controller="Employee" asp-action="Index">
                View all
                <svg viewBox="0 0 24 24"><path d="M5 12h14M13 5l7 7-7 7" /></svg>
            </a>
        </div>

        <div class="team-grid">
            @if (Model.Employees != null && Model.Employees.Any())
            {
                var i = 0;
                foreach (var employee in Model.Employees)
                {
                    var initial = !string.IsNullOrWhiteSpace(employee.FullName)
                        ? employee.FullName.Substring(0, 1).ToUpper()
                        : "U";
                    var avatarClass = avatarClasses[i % avatarClasses.Length];
                    i++;

                    <div class="team-member">
                        <div class="team-avatar @avatarClass">@initial</div>

                        <div class="team-info">
                            <strong>@employee.FullName</strong>
                            <span>
                                <svg viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="14" rx="2" /><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" /></svg>
                                @(string.IsNullOrWhiteSpace(employee.Designation) ? "No designation" : employee.Designation)
                            </span>
                        </div>

                        <div class="employee-status">
                            <span class="status-active"><i class="status-dot"></i>Active</span>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty">
                    <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /></svg>
                    No employees found.
                </div>
            }
        </div>
    </div>

    <!-- TASK OVERVIEW -->
    <div class="dashboard-section">
        <div class="dashboard-section-header">
            <div class="section-title">
                <span class="section-icon si-amber">
                    <svg viewBox="0 0 24 24"><path d="M18 20V10M12 20V4M6 20v-6" /></svg>
                </span>
                <div>
                    <h2>Task Overview</h2>
                    <p>Current team workload</p>
                </div>
            </div>
            <a class="section-link" asp-controller="Task" asp-action="Index">
                View tasks
                <svg viewBox="0 0 24 24"><path d="M5 12h14M13 5l7 7-7 7" /></svg>
            </a>
        </div>

        <div class="task-overview">

            <div class="task-overview-item t-total">
                <span class="task-icon">
                    <svg viewBox="0 0 24 24"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" /></svg>
                </span>
                <strong>@Model.TotalTasks</strong>
                <span>Total</span>
            </div>

            <div class="task-overview-item t-done">
                <span class="task-icon">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><path d="M8 12l3 3 5-6" /></svg>
                </span>
                <strong>@Model.CompletedTasks</strong>
                <span>Completed</span>
            </div>

            <div class="task-overview-item t-progress">
                <span class="task-icon">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><path d="M12 6v6l4 2" /></svg>
                </span>
                <strong>@Model.InProgressTasks</strong>
                <span>In Progress</span>
            </div>

        </div>

        <div class="task-progress" role="progressbar" aria-valuenow="@completionPercent" aria-valuemin="0" aria-valuemax="100">
            <div class="task-progress-label">
                <span>Overall completion</span>
                <strong>@completionPercent%</strong>
            </div>
            <div class="task-progress-track">
                <div class="task-progress-fill" style="width:@(completionPercent)%"></div>
            </div>
        </div>
    </div>

</div>