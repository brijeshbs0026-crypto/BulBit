@model RegisterViewModel

@{
ViewData["Title"] = "Register";
}

<style>
    /* =========================================================
       REGISTER PAGE
       ========================================================= */



       /* =========================================================
   REGISTER - FINAL DESKTOP OVERFLOW + ICON FIX
   ========================================================= */

/* Keep the whole register screen inside the viewport */
.auth-v2-page {
    min-height: 100vh !important;
    height: 100vh !important;

    box-sizing: border-box !important;

    display: flex !important;
    align-items: center !important;
    justify-content: center !important;

    padding: 12px 30px 18px !important;

    overflow: hidden !important;
}


/* Main register card */
.auth-v2-wrapper {
    width: 100% !important;
    max-width: 1080px !important;

    height: calc(100vh - 30px) !important;
    max-height: calc(100vh - 30px) !important;

    min-height: 0 !important;

    transform: translateY(-5px) !important;

    overflow: hidden !important;
}


/* Keep both sides inside the card */
.auth-v2-left,
.auth-v2-right {
    min-height: 0 !important;
    box-sizing: border-box !important;
}


/* Left side slightly more compact */
.auth-v2-left {
    padding: 25px 38px !important;
}


/* Smaller image */
.auth-v2-left-image {
    width: 175px !important;
    height: 175px !important;

    margin-bottom: 14px !important;
}


/* Left heading */
.auth-v2-left-content h2 {
    font-size: 23px !important;
    margin-bottom: 6px !important;
}


/* Left paragraph */
.auth-v2-left-content p {
    font-size: 10px !important;
    line-height: 1.5 !important;
}


/* Features */
.auth-v2-features {
    margin-top: 12px !important;
    gap: 6px !important;
}


/* =========================================================
   REGISTER FORM
   ========================================================= */

.auth-v2-right {
    padding: 20px 55px !important;

    overflow: hidden !important;
}


.auth-v2-form {
    width: 100% !important;
    max-width: 420px !important;
}


/* Header */
.auth-v2-form-header {
    margin-bottom: 12px !important;
}


.auth-v2-form-header h1 {
    font-size: 27px !important;

    margin-bottom: 4px !important;
}


.auth-v2-form-header p {
    font-size: 10px !important;
}


/* Error */
.auth-v2-error {
    margin-bottom: 8px !important;

    padding: 7px 10px !important;

    font-size: 9px !important;
}


/* Form groups */
.auth-v2-form-group {
    margin-bottom: 7px !important;
}


/* Labels */
.auth-v2-form-group label {
    margin-bottom: 3px !important;

    font-size: 9px !important;
}


/* Inputs */
.auth-v2-input {
    height: 38px !important;

    padding-top: 0 !important;
    padding-bottom: 0 !important;

    font-size: 10px !important;

    box-sizing: border-box !important;
}


/* =========================================================
   IMPORTANT: FIX ICON / TEXT OVERLAP
   ========================================================= */

.auth-v2-input-wrapper {
    position: relative !important;

    width: 100% !important;

    display: block !important;
}


/* Input text starts safely after icon */
.auth-v2-input-wrapper .auth-v2-input {
    padding-left: 45px !important;

    padding-right: 40px !important;
}


/* Icon */
.auth-v2-input-wrapper .auth-v2-input-icon {
    position: absolute !important;

    left: 13px !important;
    top: 50% !important;

    width: 18px !important;
    height: 18px !important;

    transform: translateY(-50%) !important;

    display: flex !important;
    align-items: center !important;
    justify-content: center !important;

    z-index: 5 !important;

    color: #929db0 !important;

    pointer-events: none !important;
}


/* Icon itself */
.auth-v2-input-wrapper .auth-v2-input-icon svg {
    width: 16px !important;
    height: 16px !important;

    display: block !important;

    stroke: currentColor !important;

    pointer-events: none !important;
}


/* Icon changes on focus */
.auth-v2-input-wrapper:focus-within
.auth-v2-input-icon {
    color: #6e50e9 !important;
}


/* =========================================================
   PASSWORD EYE
   ========================================================= */

.auth-v2-input-wrapper .auth-v2-password-toggle {
    position: absolute !important;

    right: 6px !important;
    top: 50% !important;

    transform: translateY(-50%) !important;

    width: 29px !important;
    height: 29px !important;

    z-index: 6 !important;
}


/* =========================================================
   ROLE SELECT
   ========================================================= */

select.auth-v2-input {
    padding-left: 45px !important;

    padding-right: 38px !important;
}


/* =========================================================
   VALIDATION
   ========================================================= */

.auth-v2-validation {
    margin-top: 2px !important;

    font-size: 7px !important;
}


/* =========================================================
   CREATE ACCOUNT BUTTON
   ========================================================= */

.auth-v2-button {
    height: 41px !important;

    margin-top: 3px !important;

    font-size: 11px !important;
}


/* =========================================================
   FOOTER
   ========================================================= */

.auth-v2-footer {
    margin-top: 8px !important;

    padding-top: 8px !important;

    font-size: 8px !important;
}


/* =========================================================
   SECURITY
   ========================================================= */

.auth-v2-security {
    margin-top: 5px !important;

    font-size: 7px !important;
}


/* =========================================================
   TABLET
   ========================================================= */

@@media (max-width: 900px) {

    .auth-v2-page {
        height: 100vh !important;

        padding: 10px 18px !important;
    }

    .auth-v2-wrapper {
        height: calc(100vh - 20px) !important;
        max-height: calc(100vh - 20px) !important;
    }

    .auth-v2-left {
        padding: 20px 22px !important;
    }

    .auth-v2-right {
        padding: 18px 28px !important;
    }

    .auth-v2-left-image {
        width: 145px !important;
        height: 145px !important;
    }
}


/* =========================================================
   MOBILE
   ========================================================= */

@@media (max-width: 680px) {

    .auth-v2-page {
        height: auto !important;
        min-height: 100vh !important;

        padding: 10px !important;

        overflow-y: auto !important;
    }

    .auth-v2-wrapper {
        height: auto !important;
        max-height: none !important;
        min-height: auto !important;

        transform: none !important;

        overflow: hidden !important;
    }

    .auth-v2-left {
        padding: 22px 20px 18px !important;
    }

    .auth-v2-right {
        padding: 22px 20px 22px !important;

        overflow: visible !important;
    }

    .auth-v2-left-image {
        width: 120px !important;
        height: 120px !important;
    }

    .auth-v2-input {
        height: 40px !important;
    }

    .auth-v2-form-group {
        margin-bottom: 9px !important;
    }

    .auth-v2-button {
        height: 42px !important;
    }
}


/* =========================================================
   SMALL MOBILE
   ========================================================= */

@@media (max-width: 400px) {

    .auth-v2-page {
        padding: 6px !important;
    }

    .auth-v2-right {
        padding: 20px 16px !important;
    }

    .auth-v2-left {
        padding: 19px 16px !important;
    }

    .auth-v2-left-image {
        width: 105px !important;
        height: 105px !important;
    }
}

    .auth-v2-page {
        min-height: 100vh;
        width: 100%;

        display: flex;
        align-items: center;
        justify-content: center;

        padding: 14px 35px 24px;

        box-sizing: border-box;

        position: relative;
        overflow: hidden;

        background:
            radial-gradient(
                circle at 10% 20%,
                rgba(112, 82, 239, 0.10),
                transparent 30%
            ),
            radial-gradient(
                circle at 90% 80%,
                rgba(82, 125, 240, 0.10),
                transparent 30%
            ),
            #f6f8fc;
    }


    /* =========================================================
       BACKGROUND DECORATION
       ========================================================= */

    .auth-v2-page::before {
        content: "";

        position: absolute;

        width: 420px;
        height: 420px;

        top: -190px;
        left: -170px;

        border-radius: 50%;

        background:
            linear-gradient(
                135deg,
                rgba(111, 79, 238, 0.13),
                rgba(111, 79, 238, 0.02)
            );

        pointer-events: none;
    }


    .auth-v2-page::after {
        content: "";

        position: absolute;

        width: 360px;
        height: 360px;

        right: -170px;
        bottom: -160px;

        border-radius: 50%;

        background:
            linear-gradient(
                135deg,
                rgba(67, 122, 235, 0.11),
                rgba(67, 122, 235, 0.01)
            );

        pointer-events: none;
    }


    /* =========================================================
       MAIN CARD
       ========================================================= */

    .auth-v2-wrapper {
        position: relative;
        z-index: 2;

        width: 100%;
        max-width: 1080px;

        min-height: 610px;

        display: grid;

        grid-template-columns: 1fr 1fr;

        overflow: hidden;

        background: #ffffff;

        border: 1px solid #e4e8f0;

        border-radius: 26px;

        box-shadow:
            0 25px 70px rgba(28, 38, 67, 0.12),
            0 8px 25px rgba(28, 38, 67, 0.05);

        transform: translateY(-8px);
    }


    /* =========================================================
       LEFT SIDE
       ========================================================= */

    .auth-v2-left {
        position: relative;

        display: flex;

        align-items: center;
        justify-content: center;

        padding: 36px 40px;

        box-sizing: border-box;

        overflow: hidden;

        background:
            linear-gradient(
                145deg,
                #f2efff 0%,
                #f7f8ff 48%,
                #edf4ff 100%
            );
    }


    .auth-v2-left::before {
        content: "";

        position: absolute;

        width: 260px;
        height: 260px;

        top: -120px;
        right: -100px;

        border-radius: 50%;

        background:
            rgba(112, 80, 237, 0.10);
    }


    .auth-v2-left::after {
        content: "";

        position: absolute;

        width: 180px;
        height: 180px;

        bottom: -90px;
        left: -70px;

        border-radius: 50%;

        background:
            rgba(70, 126, 239, 0.08);
    }


    /* =========================================================
       LEFT CONTENT
       ========================================================= */

    .auth-v2-left-content {
        position: relative;
        z-index: 2;

        width: 100%;
        max-width: 430px;

        display: flex;

        flex-direction: column;

        align-items: center;

        text-align: center;
    }


    /* =========================================================
       IMAGE
       ========================================================= */

    .auth-v2-left-image {
        width: 205px;
        height: 205px;

        display: flex;

        align-items: center;
        justify-content: center;

        margin-bottom: 18px;

        padding: 10px;

        box-sizing: border-box;

        background: #ffffff;

        border: 1px solid
            rgba(107, 83, 230, 0.10);

        border-radius: 21px;

        box-shadow:
            0 18px 38px
            rgba(81, 68, 154, 0.14);

        overflow: hidden;
    }


    .auth-side-image {
        width: 100%;
        height: 100%;

        display: block;

        object-fit: cover;

        border-radius: 14px;
    }


    /* =========================================================
       BRAND BADGE
       ========================================================= */

    .auth-v2-brand-badge {
        display: inline-flex;

        align-items: center;

        gap: 7px;

        margin-bottom: 11px;

        padding: 6px 10px;

        border-radius: 20px;

        background:
            rgba(255, 255, 255, 0.72);

        border: 1px solid
            rgba(110, 82, 235, 0.13);

        color: #684be0;

        font-size: 10px;

        font-weight: 800;

        letter-spacing: 0.7px;

        box-shadow:
            0 5px 14px
            rgba(70, 70, 120, 0.05);
    }


    .auth-v2-brand-badge-icon {
        width: 18px;
        height: 18px;

        display: flex;

        align-items: center;
        justify-content: center;

        border-radius: 6px;

        background:
            linear-gradient(
                135deg,
                #7d5af5,
                #6242df
            );

        color: #ffffff;

        font-size: 9px;

        font-weight: 800;
    }


    /* =========================================================
       LEFT HEADING
       ========================================================= */

    .auth-v2-left-content h2 {
        margin: 0 0 8px;

        color: #172139;

        font-family:
            'Outfit',
            sans-serif;

        font-size: 25px;

        line-height: 1.15;

        font-weight: 800;

        letter-spacing: -0.7px;
    }


    .auth-v2-left-content p {
        max-width: 390px;

        margin: 0;

        color: #8490a6;

        font-size: 11px;

        line-height: 1.65;
    }


    /* =========================================================
       FEATURES
       ========================================================= */

    .auth-v2-features {
        display: flex;

        align-items: center;
        justify-content: center;

        flex-wrap: wrap;

        gap: 7px;

        margin-top: 17px;
    }


    .auth-v2-feature {
        display: inline-flex;

        align-items: center;

        gap: 6px;

        padding: 6px 8px;

        border-radius: 9px;

        background:
            rgba(255, 255, 255, 0.65);

        border: 1px solid
            rgba(104, 78, 224, 0.09);

        color: #77839a;

        font-size: 9px;

        font-weight: 650;
    }


    .auth-v2-feature-icon {
        color: #6d50e8;

        font-size: 11px;
    }


    /* =========================================================
       RIGHT SIDE
       ========================================================= */

    .auth-v2-right {
        display: flex;

        align-items: center;
        justify-content: center;

        padding: 26px 58px;

        box-sizing: border-box;

        background: #ffffff;
    }


    /* =========================================================
       REGISTER FORM
       ========================================================= */

    .auth-v2-form {
        width: 100%;

        max-width: 410px;
    }


    .auth-v2-register {
        max-width: 420px;
    }


    /* =========================================================
       FORM HEADER
       ========================================================= */

    .auth-v2-form-header {
        margin-bottom: 15px;
    }


    .auth-v2-form-header h1 {
        margin: 0 0 5px;

        color: #162139;

        font-family:
            'Outfit',
            sans-serif;

        font-size: 29px;

        line-height: 1.15;

        font-weight: 800;

        letter-spacing: -0.8px;
    }


    .auth-v2-form-header p {
        margin: 0;

        color: #8b96aa;

        font-size: 10px;

        line-height: 1.5;
    }


    /* =========================================================
       ERROR
       ========================================================= */

    .auth-v2-error {
        margin-bottom: 11px;

        padding: 8px 11px;

        border-radius: 9px;

        background: #fff1f3;

        border: 1px solid #ffd5db;

        color: #c84758;

        font-size: 9px;

        line-height: 1.45;
    }


    /* =========================================================
       FORM GROUP
       ========================================================= */

    .auth-v2-form-group {
        margin-bottom: 9px;

        position: relative;
    }


    .auth-v2-form-group label {
        display: block;

        margin-bottom: 4px;

        color: #202c43;

        font-size: 9px;

        font-weight: 750;
    }


    /* =========================================================
       INPUT WRAPPER
       ========================================================= */

    .auth-v2-input-wrapper {
        position: relative;

        width: 100%;
    }


    /* =========================================================
       INPUT
       ========================================================= */

    .auth-v2-input {
        width: 100%;

        height: 40px;

        box-sizing: border-box;

        padding: 0 13px 0 40px;

        border: 1px solid #dfe5ed;

        border-radius: 9px;

        outline: none;

        background: #f9fbfd;

        color: #182238;

        font-family:
            'Inter',
            sans-serif;

        font-size: 10px;

        font-weight: 500;

        transition:
            border-color 0.2s ease,
            box-shadow 0.2s ease,
            background 0.2s ease;
    }


    .auth-v2-input::placeholder {
        color: #a4adbb;
    }


    .auth-v2-input:hover {
        border-color: #d2d9e4;

        background: #ffffff;
    }


    .auth-v2-input:focus {
        border-color: #7052ed;

        background: #ffffff;

        box-shadow:
            0 0 0 4px
            rgba(112, 82, 237, 0.09);
    }


    /* =========================================================
       SELECT
       ========================================================= */

    select.auth-v2-input {
        appearance: none;
        -webkit-appearance: none;

        cursor: pointer;

        padding-right: 38px;

        background-image:
            linear-gradient(
                45deg,
                transparent 50%,
                #7f8aa0 50%
            ),
            linear-gradient(
                135deg,
                #7f8aa0 50%,
                transparent 50%
            );

        background-position:
            calc(100% - 16px) 17px,
            calc(100% - 11px) 17px;

        background-size:
            5px 5px,
            5px 5px;

        background-repeat: no-repeat;
    }


    select.auth-v2-input:focus {
        background-image:
            linear-gradient(
                45deg,
                transparent 50%,
                #7052ed 50%
            ),
            linear-gradient(
                135deg,
                #7052ed 50%,
                transparent 50%
            );
    }


    /* =========================================================
       INPUT ICON
       ========================================================= */

    .auth-v2-input-icon {
        position: absolute;

        left: 12px;

        top: 50%;

        width: 17px;
        height: 17px;

        transform:
            translateY(-50%);

        display: flex;

        align-items: center;
        justify-content: center;

        color: #929db0;

        pointer-events: none;

        transition:
            color 0.2s ease;
    }


    .auth-v2-input-icon svg {
        width: 15px;
        height: 15px;

        stroke: currentColor;
    }


    .auth-v2-input-wrapper:focus-within
    .auth-v2-input-icon {
        color: #6e50e9;
    }


    /* =========================================================
       PASSWORD TOGGLE
       ========================================================= */

    .auth-v2-password-toggle {
        position: absolute;

        right: 6px;

        top: 50%;

        transform:
            translateY(-50%);

        width: 30px;
        height: 30px;

        display: flex;

        align-items: center;
        justify-content: center;

        border: none;

        border-radius: 7px;

        background: transparent;

        color: #8994a8;

        cursor: pointer;

        transition:
            background 0.2s ease,
            color 0.2s ease;
    }


    .auth-v2-password-toggle:hover {
        background: #f0edff;

        color: #6548df;
    }


    .auth-v2-password-toggle svg {
        width: 14px;
        height: 14px;
    }


    /* =========================================================
       VALIDATION
       ========================================================= */

    .auth-v2-validation {
        display: block;

        margin-top: 3px;

        color: #d24d5a;

        font-size: 8px;
    }


    /* =========================================================
       CREATE ACCOUNT BUTTON
       ========================================================= */

    .auth-v2-button {
        width: 100%;

        height: 43px;

        display: flex;

        align-items: center;
        justify-content: center;

        gap: 8px;

        margin-top: 4px;

        border: none;

        border-radius: 9px;

        background:
            linear-gradient(
                135deg,
                #7053ef,
                #5d48e7
            );

        color: #ffffff;

        font-family:
            'Inter',
            sans-serif;

        font-size: 11px;

        font-weight: 800;

        cursor: pointer;

        box-shadow:
            0 10px 22px
            rgba(101, 73, 232, 0.23);

        transition:
            transform 0.2s ease,
            box-shadow 0.2s ease,
            filter 0.2s ease;
    }


    .auth-v2-button::before {
        content: "✓";

        width: 18px;
        height: 18px;

        display: inline-flex;

        align-items: center;
        justify-content: center;

        border-radius: 6px;

        background:
            rgba(255,255,255,0.15);

        font-size: 10px;
    }


    .auth-v2-button:hover {
        transform: translateY(-2px);

        filter: brightness(1.03);

        box-shadow:
            0 14px 28px
            rgba(101, 73, 232, 0.29);
    }


    .auth-v2-button:active {
        transform: translateY(0);
    }


    /* =========================================================
       FOOTER
       ========================================================= */

    .auth-v2-footer {
        position: relative;

        margin: 12px 0 0;

        padding-top: 11px;

        border-top: 1px solid #edf0f4;

        text-align: center;

        color: #929cad;

        font-size: 9px;
    }


    .auth-v2-footer a {
        color: #6046e2;

        text-decoration: none;

        font-weight: 800;

        transition:
            color 0.2s ease;
    }


    .auth-v2-footer a:hover {
        color: #4f36cc;

        text-decoration: underline;
    }


    /* =========================================================
       SECURITY
       ========================================================= */

    .auth-v2-security {
        display: flex;

        align-items: center;
        justify-content: center;

        gap: 5px;

        margin-top: 8px;

        color: #a0a8b7;

        font-size: 7px;
    }


    .auth-v2-security svg {
        width: 11px;
        height: 11px;

        color: #6c8edb;
    }


    /* =========================================================
       TABLET
       ========================================================= */

    @@media (max-width: 900px) {

        .auth-v2-page {
            padding: 18px 22px 24px;
        }


        .auth-v2-wrapper {
            max-width: 760px;

            min-height: 570px;
        }


        .auth-v2-left {
            padding: 30px 25px;
        }


        .auth-v2-right {
            padding: 25px 30px;
        }


        .auth-v2-left-image {
            width: 175px;
            height: 175px;
        }


        .auth-v2-left-content h2 {
            font-size: 21px;
        }


        .auth-v2-form-header h1 {
            font-size: 26px;
        }
    }


    /* =========================================================
       MOBILE
       ========================================================= */

    @@media (max-width: 680px) {

        .auth-v2-page {
            min-height: 100vh;

            padding: 12px;

            overflow-y: auto;
        }


        .auth-v2-wrapper {
            display: flex;

            flex-direction: column;

            max-width: 470px;

            min-height: auto;

            border-radius: 20px;

            transform: none;
        }


        .auth-v2-left {
            padding: 25px 22px 21px;
        }


        .auth-v2-left-image {
            width: 125px;
            height: 125px;

            margin-bottom: 14px;

            padding: 7px;

            border-radius: 17px;
        }


        .auth-side-image {
            border-radius: 10px;
        }


        .auth-v2-brand-badge {
            margin-bottom: 8px;
        }


        .auth-v2-left-content h2 {
            font-size: 19px;
        }


        .auth-v2-left-content p {
            font-size: 10px;

            line-height: 1.55;
        }


        .auth-v2-features {
            margin-top: 12px;
        }


        .auth-v2-right {
            padding: 25px 22px 24px;
        }


        .auth-v2-form-header {
            margin-bottom: 17px;
        }


        .auth-v2-form-header h1 {
            font-size: 25px;
        }


        .auth-v2-form-group {
            margin-bottom: 10px;
        }
    }


    /* =========================================================
       SMALL MOBILE
       ========================================================= */

    @@media (max-width: 400px) {

        .auth-v2-page {
            padding: 7px;
        }


        .auth-v2-wrapper {
            border-radius: 16px;
        }


        .auth-v2-left {
            padding: 21px 17px;
        }


        .auth-v2-right {
            padding: 22px 17px;
        }


        .auth-v2-left-image {
            width: 105px;
            height: 105px;
        }


        .auth-v2-features {
            display: none;
        }


        .auth-v2-input {
            height: 39px;
        }


        .auth-v2-button {
            height: 42px;
        }
    }
</style>


<div class="auth-v2-page">


    <div class="auth-v2-wrapper">


        <!-- =====================================================
             LEFT SIDE
             ===================================================== -->

        <div class="auth-v2-left">


            <div class="auth-v2-left-content">


                <div class="auth-v2-left-image">

                    <img src="~/image/login-image.jpg"
                         alt="BulBit Workspace"
                         class="auth-side-image" />

                </div>


                <div class="auth-v2-brand-badge">

                    <span class="auth-v2-brand-badge-icon">
                        B
                    </span>

                    BULBIT WORKSPACE

                </div>


                <h2>
                    Build your team together
                </h2>


                <p>

                    Create your account and start managing
                    employees, tasks, attendance and schedules
                    from one simple workspace.

                </p>


                <div class="auth-v2-features">


                    <div class="auth-v2-feature">

                        <span class="auth-v2-feature-icon">
                            ✓
                        </span>

                        Team Management

                    </div>


                    <div class="auth-v2-feature">

                        <span class="auth-v2-feature-icon">
                            ✓
                        </span>

                        Task Tracking

                    </div>


                    <div class="auth-v2-feature">

                        <span class="auth-v2-feature-icon">
                            ✓
                        </span>

                        Smart Workspace

                    </div>


                </div>


            </div>


        </div>


        <!-- =====================================================
             RIGHT SIDE
             ===================================================== -->

        <div class="auth-v2-right">


            <div class="auth-v2-form auth-v2-register">


                <!-- HEADER -->

                <div class="auth-v2-form-header">

                    <h1>
                        Create account
                    </h1>

                    <p>
                        Create your account to get started.
                    </p>

                </div>


                <!-- VALIDATION -->

                @if (!ViewData.ModelState.IsValid)
                {

                    <div class="auth-v2-error"
                         asp-validation-summary="All">
                    </div>

                }


                <!-- REGISTER FORM -->

                <form asp-action="Register"
                      method="post">

                    @Html.AntiForgeryToken()


                    <!-- FULL NAME -->

                    <div class="auth-v2-form-group">


                        <label asp-for="FullName">
                            Full Name
                        </label>


                        <div class="auth-v2-input-wrapper">


                            <span class="auth-v2-input-icon">


                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8"
                                     stroke-linecap="round"
                                     stroke-linejoin="round">

                                    <circle cx="12"
                                            cy="8"
                                            r="3.5">
                                    </circle>

                                    <path d="M4 21c.7-4 3.5-6 8-6s7.3 2 8 6">
                                    </path>

                                </svg>


                            </span>


                            <input asp-for="FullName"
                                   class="auth-v2-input"
                                   placeholder="Enter your full name"
                                   autocomplete="name" />


                        </div>


                        <span asp-validation-for="FullName"
                              class="auth-v2-validation">
                        </span>


                    </div>


                    <!-- EMAIL -->

                    <div class="auth-v2-form-group">


                        <label asp-for="Email">
                            Email
                        </label>


                        <div class="auth-v2-input-wrapper">


                            <span class="auth-v2-input-icon">


                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8"
                                     stroke-linecap="round"
                                     stroke-linejoin="round">

                                    <rect x="3"
                                          y="5"
                                          width="18"
                                          height="14"
                                          rx="2">
                                    </rect>

                                    <path d="m3 7 9 6 9-6">
                                    </path>

                                </svg>


                            </span>


                            <input asp-for="Email"
                                   class="auth-v2-input"
                                   placeholder="name@example.com"
                                   autocomplete="email" />


                        </div>


                        <span asp-validation-for="Email"
                              class="auth-v2-validation">
                        </span>


                    </div>


                    <!-- PASSWORD -->

                    <div class="auth-v2-form-group">


                        <label asp-for="Password">
                            Password
                        </label>


                        <div class="auth-v2-input-wrapper">


                            <span class="auth-v2-input-icon">


                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8"
                                     stroke-linecap="round"
                                     stroke-linejoin="round">

                                    <rect x="5"
                                          y="10"
                                          width="14"
                                          height="10"
                                          rx="2">
                                    </rect>

                                    <path d="M8 10V7a4 4 0 0 1 8 0v3">
                                    </path>

                                </svg>


                            </span>


                            <input asp-for="Password"
                                   id="registerPassword"
                                   class="auth-v2-input"
                                   type="password"
                                   placeholder="Minimum 6 characters"
                                   autocomplete="new-password"
                                   style="padding-right:45px;" />


                            <button type="button"
                                    class="auth-v2-password-toggle"
                                    data-target="registerPassword"
                                    aria-label="Show password">


                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8"
                                     stroke-linecap="round"
                                     stroke-linejoin="round">

                                    <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12z">
                                    </path>

                                    <circle cx="12"
                                            cy="12"
                                            r="2.5">
                                    </circle>

                                </svg>


                            </button>


                        </div>


                        <span asp-validation-for="Password"
                              class="auth-v2-validation">
                        </span>


                    </div>


                    <!-- CONFIRM PASSWORD -->

                    <div class="auth-v2-form-group">


                        <label asp-for="ConfirmPassword">
                            Confirm Password
                        </label>


                        <div class="auth-v2-input-wrapper">


                            <span class="auth-v2-input-icon">


                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8"
                                     stroke-linecap="round"
                                     stroke-linejoin="round">

                                    <rect x="5"
                                          y="10"
                                          width="14"
                                          height="10"
                                          rx="2">
                                    </rect>

                                    <path d="M8 10V7a4 4 0 0 1 8 0v3">
                                    </path>

                                    <path d="m9 15 2 2 4-4">
                                    </path>

                                </svg>


                            </span>


                            <input asp-for="ConfirmPassword"
                                   id="confirmPassword"
                                   class="auth-v2-input"
                                   type="password"
                                   placeholder="Confirm password"
                                   autocomplete="new-password"
                                   style="padding-right:45px;" />


                            <button type="button"
                                    class="auth-v2-password-toggle"
                                    data-target="confirmPassword"
                                    aria-label="Show password">


                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8"
                                     stroke-linecap="round"
                                     stroke-linejoin="round">

                                    <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12z">
                                    </path>

                                    <circle cx="12"
                                            cy="12"
                                            r="2.5">
                                    </circle>

                                </svg>


                            </button>


                        </div>


                        <span asp-validation-for="ConfirmPassword"
                              class="auth-v2-validation">
                        </span>


                    </div>


                    <!-- ROLE -->

                    <div class="auth-v2-form-group">


                        <label asp-for="Role">
                            Account Role
                        </label>


                        <div class="auth-v2-input-wrapper">


                            <span class="auth-v2-input-icon">


                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8"
                                     stroke-linecap="round"
                                     stroke-linejoin="round">

                                    <circle cx="9"
                                            cy="8"
                                            r="3">
                                    </circle>

                                    <path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6">
                                    </path>

                                    <path d="M16 5h5">
                                    </path>

                                    <path d="M18.5 2.5v5">
                                    </path>

                                </svg>


                            </span>


                            <select asp-for="Role"
                                    class="auth-v2-input">

                                <option value="Employee">
                                    Working Employee
                                </option>

                                <option value="Admin">
                                    Administrator
                                </option>

                            </select>


                        </div>


                        <span asp-validation-for="Role"
                              class="auth-v2-validation">
                        </span>


                    </div>


                    <!-- CREATE ACCOUNT -->

                    <button type="submit"
                            class="auth-v2-button">

                        Create Account

                    </button>


                </form>


                <!-- LOGIN LINK -->

                <p class="auth-v2-footer">

                    Already registered?

                    <a asp-action="Login">
                        Sign in
                    </a>

                </p>


                <!-- SECURITY -->

                <div class="auth-v2-security">


                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <rect x="5"
                              y="10"
                              width="14"
                              height="10"
                              rx="2">
                        </rect>

                        <path d="M8 10V7a4 4 0 0 1 8 0v3">
                        </path>

                    </svg>


                    Secure account registration


                </div>


            </div>


        </div>


    </div>


</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />


    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {


                const toggleButtons =
                    document.querySelectorAll(
                        ".auth-v2-password-toggle"
                    );


                toggleButtons.forEach(
                    function (button) {


                        button.addEventListener(
                            "click",
                            function () {


                                const targetId =
                                    button.getAttribute(
                                        "data-target"
                                    );


                                const password =
                                    document.getElementById(
                                        targetId
                                    );


                                if (!password) {
                                    return;
                                }


                                const showing =
                                    password.type ===
                                    "text";


                                password.type =
                                    showing
                                        ? "password"
                                        : "text";


                                button.setAttribute(
                                    "aria-label",
                                    showing
                                        ? "Show password"
                                        : "Hide password"
                                );


                                if (!showing) {

                                    button.innerHTML = `
                                        <svg viewBox="0 0 24 24"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="1.8"
                                             stroke-linecap="round"
                                             stroke-linejoin="round">

                                            <path d="M3 3l18 18"></path>

                                            <path d="M10.6 10.6a2 2 0 0 0 2.8 2.8"></path>

                                            <path d="M9.9 5.2A10.8 10.8 0 0 1 12 5c6.5 0 10 7 10 7a17.2 17.2 0 0 1-3.1 3.8"></path>

                                            <path d="M6.1 6.1C3.5 8.1 2 12 2 12s3.5 7 10 7c1.7 0 3.2-.4 4.5-1"></path>

                                        </svg>
                                    `;

                                }
                                else {

                                    button.innerHTML = `
                                        <svg viewBox="0 0 24 24"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="1.8"
                                             stroke-linecap="round"
                                             stroke-linejoin="round">

                                            <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12z"></path>

                                            <circle cx="12"
                                                    cy="12"
                                                    r="2.5"></circle>

                                        </svg>
                                    `;

                                }

                            }
                        );

                    }
                );


            }
        );

    </script>

}