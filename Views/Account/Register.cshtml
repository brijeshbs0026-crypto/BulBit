@model RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<div class="auth-v2-page">

    <div class="auth-v2-wrapper">

        <!-- LEFT SIDE -->
        <div class="auth-v2-left">

            <div class="auth-v2-left-content">

                <div class="auth-v2-left-image">
                    <img src="~/image/login-image.jpg"
                         alt="Welcome"
                         class="auth-side-image" />
                </div>

                <h2>Build your team together</h2>

                <p>
                    Create your account and start managing
                    employees, tasks, attendance and schedules
                    from one simple workspace.
                </p>

            </div>

        </div>


        <!-- RIGHT SIDE -->
        <div class="auth-v2-right">

            <div class="auth-v2-form auth-v2-register">

                <div class="auth-v2-form-header">

                    <h1>Create account</h1>

                    <p>
                        Create your account to get started.
                    </p>

                </div>


                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="auth-v2-error"
                         asp-validation-summary="All">
                    </div>
                }


                <form asp-action="Register" method="post">

                    @Html.AntiForgeryToken()


                    <div class="auth-v2-form-group">

                        <label asp-for="FullName"></label>

                        <input asp-for="FullName"
                               class="auth-v2-input"
                               placeholder="Full name"
                               autocomplete="name" />

                        <span asp-validation-for="FullName"
                              class="auth-v2-validation">
                        </span>

                    </div>


                    <div class="auth-v2-form-group">

                        <label asp-for="Email"></label>

                        <input asp-for="Email"
                               class="auth-v2-input"
                               placeholder="name@example.com"
                               autocomplete="email" />

                        <span asp-validation-for="Email"
                              class="auth-v2-validation">
                        </span>

                    </div>


                    <div class="auth-v2-form-group">

                        <label asp-for="Password"></label>

                        <input asp-for="Password"
                               class="auth-v2-input"
                               type="password"
                               placeholder="Minimum 6 characters"
                               autocomplete="new-password" />

                        <span asp-validation-for="Password"
                              class="auth-v2-validation">
                        </span>

                    </div>


                    <div class="auth-v2-form-group">

                        <label asp-for="ConfirmPassword"></label>

                        <input asp-for="ConfirmPassword"
                               class="auth-v2-input"
                               type="password"
                               placeholder="Confirm password"
                               autocomplete="new-password" />

                        <span asp-validation-for="ConfirmPassword"
                              class="auth-v2-validation">
                        </span>

                    </div>


                    <div class="auth-v2-form-group">

                        <label asp-for="Role">Account Role</label>

                        <select asp-for="Role"
                                class="auth-v2-input"
                                style="cursor: pointer;">
                            <option value="Employee">Working Employee</option>
                            <option value="Admin">Administrator</option>
                        </select>

                        <span asp-validation-for="Role"
                              class="auth-v2-validation">
                        </span>

                    </div>


                    <button type="submit"
                            class="auth-v2-button">

                        Create Account

                    </button>

                </form>


                <p class="auth-v2-footer">

                    Already registered?

                    <a asp-action="Login">
                        Sign in
                    </a>

                </p>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}