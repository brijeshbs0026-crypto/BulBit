
@model LoginViewModel

@{
ViewData["Title"] = "Login";
}

<style>

    /* =========================================================
       AUTH PAGE
       ========================================================= */




       /* =========================================================
   LOGIN - FINAL INPUT ICON / TEXT OVERLAP FIX
   ========================================================= */

/* Input wrapper */
.auth-v2-input-wrapper {
    position: relative !important;
    width: 100% !important;
    display: block !important;
}


/* Normal inputs */
.auth-v2-input-wrapper .auth-v2-input {
    position: relative !important;
    z-index: 1 !important;

    width: 100% !important;

    box-sizing: border-box !important;

    /* IMPORTANT: leave enough room for the icon */
    padding-left: 48px !important;

    /* room for password eye */
    padding-right: 44px !important;
}


/* =========================================================
   LEFT INPUT ICON
   ========================================================= */

.auth-v2-input-wrapper .auth-v2-input-icon {
    position: absolute !important;

    left: 15px !important;
    top: 50% !important;

    width: 18px !important;
    height: 18px !important;

    transform: translateY(-50%) !important;

    display: flex !important;
    align-items: center !important;
    justify-content: center !important;

    z-index: 5 !important;

    color: #929db0 !important;

    pointer-events: none !important;
}


/* SVG inside icon */
.auth-v2-input-wrapper .auth-v2-input-icon svg {
    width: 16px !important;
    height: 16px !important;

    display: block !important;

    stroke: currentColor !important;

    pointer-events: none !important;
}


/* Purple icon when input is focused */
.auth-v2-input-wrapper:focus-within
.auth-v2-input-icon {
    color: #6e50e9 !important;
}


/* =========================================================
   PASSWORD EYE BUTTON
   ========================================================= */

.auth-v2-input-wrapper .auth-v2-password-toggle {
    position: absolute !important;

    right: 6px !important;
    top: 50% !important;

    width: 30px !important;
    height: 30px !important;

    transform: translateY(-50%) !important;

    z-index: 6 !important;

    display: flex !important;
    align-items: center !important;
    justify-content: center !important;

    border: none !important;

    border-radius: 7px !important;

    background: transparent !important;

    color: #8994a8 !important;

    cursor: pointer !important;
}


/* Eye icon */
.auth-v2-input-wrapper .auth-v2-password-toggle svg {
    width: 15px !important;
    height: 15px !important;

    display: block !important;
}


/* =========================================================
   LOGIN EMAIL / PASSWORD PLACEHOLDER
   ========================================================= */

.auth-v2-input-wrapper .auth-v2-input::placeholder {
    padding-left: 0 !important;

    color: #a4adbb !important;
}


/* =========================================================
   REMEMBER ME - NO CHANGE TO FUNCTIONALITY
   ========================================================= */

.auth-v2-check {
    position: relative;
    z-index: 1;
}


/* =========================================================
   MOBILE
   ========================================================= */

@@media (max-width: 680px) {

    .auth-v2-input-wrapper .auth-v2-input {
        padding-left: 46px !important;

        padding-right: 42px !important;
    }

    .auth-v2-input-wrapper .auth-v2-input-icon {
        left: 14px !important;
    }
}


    .auth-v2-page {
        width: 100%;

        min-height: 100vh;

        display: flex;

        align-items: center;
        justify-content: center;

        padding: 18px 35px 28px;

        box-sizing: border-box;

        position: relative;

        overflow: hidden;

        background:
            radial-gradient(
                circle at 10% 20%,
                rgba(112, 82, 239, 0.10),
                transparent 30%
            ),
            radial-gradient(
                circle at 90% 80%,
                rgba(82, 125, 240, 0.10),
                transparent 30%
            ),
            #f6f8fc;
    }


    /* =========================================================
       DECORATIVE BACKGROUND
       ========================================================= */

    .auth-v2-page::before {
        content: "";

        position: absolute;

        width: 420px;
        height: 420px;

        top: -190px;
        left: -170px;

        border-radius: 50%;

        background:
            linear-gradient(
                135deg,
                rgba(111, 79, 238, 0.13),
                rgba(111, 79, 238, 0.02)
            );

        pointer-events: none;
    }


    .auth-v2-page::after {
        content: "";

        position: absolute;

        width: 360px;
        height: 360px;

        right: -170px;
        bottom: -160px;

        border-radius: 50%;

        background:
            linear-gradient(
                135deg,
                rgba(67, 122, 235, 0.11),
                rgba(67, 122, 235, 0.01)
            );

        pointer-events: none;
    }


    /* =========================================================
       MAIN WRAPPER
       ========================================================= */

    .auth-v2-wrapper {

        position: relative;

        z-index: 2;

        width: 100%;

        max-width: 1080px;

        min-height: 620px;

        display: grid;

        grid-template-columns:
            1fr 1fr;

        overflow: hidden;

        background: #ffffff;

        border: 1px solid #e4e8f0;

        border-radius: 26px;

        box-shadow:
            0 25px 70px rgba(28, 38, 67, 0.12),
            0 8px 25px rgba(28, 38, 67, 0.05);

        transform: translateY(-8px);
    }


    /* =========================================================
       LEFT SIDE
       ========================================================= */

    .auth-v2-left {

        position: relative;

        display: flex;

        align-items: center;
        justify-content: center;

        padding: 38px 40px;

        box-sizing: border-box;

        overflow: hidden;

        background:
            linear-gradient(
                145deg,
                #f2efff 0%,
                #f7f8ff 48%,
                #edf4ff 100%
            );
    }


    .auth-v2-left::before {

        content: "";

        position: absolute;

        width: 260px;
        height: 260px;

        top: -120px;
        right: -100px;

        border-radius: 50%;

        background:
            rgba(112, 80, 237, 0.10);
    }


    .auth-v2-left::after {

        content: "";

        position: absolute;

        width: 180px;
        height: 180px;

        bottom: -90px;
        left: -70px;

        border-radius: 50%;

        background:
            rgba(70, 126, 239, 0.08);
    }


    /* =========================================================
       LEFT CONTENT
       ========================================================= */

    .auth-v2-left-content {

        position: relative;

        z-index: 2;

        width: 100%;

        max-width: 430px;

        display: flex;

        flex-direction: column;

        align-items: center;

        text-align: center;
    }


    /* =========================================================
       IMAGE
       ========================================================= */

    .auth-v2-left-image {

        width: 225px;

        height: 225px;

        display: flex;

        align-items: center;
        justify-content: center;

        margin-bottom: 20px;

        padding: 10px;

        box-sizing: border-box;

        background: #ffffff;

        border: 1px solid rgba(107, 83, 230, 0.10);

        border-radius: 22px;

        box-shadow:
            0 18px 38px
            rgba(81, 68, 154, 0.14);

        overflow: hidden;
    }


    .auth-side-image {

        width: 100%;

        height: 100%;

        display: block;

        object-fit: cover;

        border-radius: 15px;
    }


    /* =========================================================
       LEFT BADGE
       ========================================================= */

    .auth-v2-brand-badge {

        display: inline-flex;

        align-items: center;

        gap: 7px;

        margin-bottom: 13px;

        padding: 7px 11px;

        border-radius: 20px;

        background:
            rgba(255, 255, 255, 0.72);

        border: 1px solid
            rgba(110, 82, 235, 0.13);

        color: #684be0;

        font-size: 10px;

        font-weight: 800;

        letter-spacing: 0.7px;

        box-shadow:
            0 5px 14px
            rgba(70, 70, 120, 0.05);
    }


    .auth-v2-brand-badge-icon {

        width: 18px;
        height: 18px;

        display: flex;

        align-items: center;
        justify-content: center;

        border-radius: 6px;

        background:
            linear-gradient(
                135deg,
                #7d5af5,
                #6242df
            );

        color: #ffffff;

        font-size: 9px;

        font-weight: 800;
    }


    /* =========================================================
       LEFT HEADING
       ========================================================= */

    .auth-v2-left-content h2 {

        margin: 0 0 9px;

        color: #172139;

        font-family:
            'Outfit',
            sans-serif;

        font-size: 26px;

        line-height: 1.15;

        font-weight: 800;

        letter-spacing: -0.7px;
    }


    .auth-v2-left-content p {

        max-width: 390px;

        margin: 0;

        color: #8490a6;

        font-size: 12px;

        line-height: 1.7;
    }


    /* =========================================================
       FEATURE ITEMS
       ========================================================= */

    .auth-v2-features {

        display: flex;

        align-items: center;
        justify-content: center;

        flex-wrap: wrap;

        gap: 8px;

        margin-top: 20px;
    }


    .auth-v2-feature {

        display: inline-flex;

        align-items: center;

        gap: 6px;

        padding: 7px 9px;

        border-radius: 9px;

        background:
            rgba(255, 255, 255, 0.65);

        border: 1px solid
            rgba(104, 78, 224, 0.09);

        color: #77839a;

        font-size: 9px;

        font-weight: 650;
    }


    .auth-v2-feature-icon {

        color: #6d50e8;

        font-size: 11px;
    }


    /* =========================================================
       RIGHT SIDE
       ========================================================= */

    .auth-v2-right {

        display: flex;

        align-items: center;

        justify-content: center;

        padding: 40px 58px;

        box-sizing: border-box;

        background: #ffffff;
    }


    /* =========================================================
       FORM
       ========================================================= */

    .auth-v2-form {

        width: 100%;

        max-width: 410px;
    }


    /* =========================================================
       FORM HEADER
       ========================================================= */

    .auth-v2-form-header {

        margin-bottom: 24px;
    }


    .auth-v2-form-header h1 {

        margin: 0 0 7px;

        color: #162139;

        font-family:
            'Outfit',
            sans-serif;

        font-size: 30px;

        line-height: 1.15;

        font-weight: 800;

        letter-spacing: -0.8px;
    }


    .auth-v2-form-header p {

        margin: 0;

        color: #8b96aa;

        font-size: 11px;

        line-height: 1.6;
    }


    /* =========================================================
       ERROR
       ========================================================= */

    .auth-v2-error {

        margin-bottom: 16px;

        padding: 10px 12px;

        border-radius: 10px;

        background: #fff1f3;

        border: 1px solid #ffd5db;

        color: #c84758;

        font-size: 10px;

        line-height: 1.5;
    }


    /* =========================================================
       FORM GROUP
       ========================================================= */

    .auth-v2-form-group {

        margin-bottom: 15px;

        position: relative;
    }


    .auth-v2-form-group label {

        display: block;

        margin-bottom: 7px;

        color: #202c43;

        font-size: 10px;

        font-weight: 750;
    }


    /* =========================================================
       INPUT WRAPPER
       ========================================================= */

    .auth-v2-input-wrapper {

        position: relative;

        width: 100%;
    }


    /* =========================================================
       INPUT
       ========================================================= */

    .auth-v2-input {

        width: 100%;

        height: 46px;

        box-sizing: border-box;

        padding:
            0 14px 0 43px;

        border: 1px solid #dfe5ed;

        border-radius: 11px;

        outline: none;

        background: #f9fbfd;

        color: #182238;

        font-family:
            'Inter',
            sans-serif;

        font-size: 11px;

        font-weight: 500;

        transition:
            border-color 0.2s ease,
            box-shadow 0.2s ease,
            background 0.2s ease;
    }


    .auth-v2-input::placeholder {

        color: #a4adbb;
    }


    .auth-v2-input:hover {

        border-color: #d2d9e4;

        background: #ffffff;
    }


    .auth-v2-input:focus {

        border-color: #7052ed;

        background: #ffffff;

        box-shadow:
            0 0 0 4px
            rgba(112, 82, 237, 0.09);
    }


    /* =========================================================
       INPUT ICON
       ========================================================= */

    .auth-v2-input-icon {

        position: absolute;

        left: 14px;

        top: 50%;

        width: 18px;
        height: 18px;

        transform:
            translateY(-50%);

        display: flex;

        align-items: center;
        justify-content: center;

        color: #929db0;

        pointer-events: none;

        transition:
            color 0.2s ease;
    }


    .auth-v2-input-icon svg {

        width: 17px;
        height: 17px;

        stroke: currentColor;
    }


    .auth-v2-input-wrapper:focus-within
    .auth-v2-input-icon {

        color: #6e50e9;
    }


    /* =========================================================
       PASSWORD TOGGLE
       ========================================================= */

    .auth-v2-password-toggle {

        position: absolute;

        right: 9px;

        top: 50%;

        transform:
            translateY(-50%);

        width: 32px;
        height: 32px;

        display: flex;

        align-items: center;
        justify-content: center;

        border: none;

        border-radius: 8px;

        background: transparent;

        color: #8994a8;

        cursor: pointer;

        transition:
            background 0.2s ease,
            color 0.2s ease;
    }


    .auth-v2-password-toggle:hover {

        background: #f0edff;

        color: #6548df;
    }


    .auth-v2-password-toggle svg {

        width: 16px;
        height: 16px;
    }


    /* =========================================================
       VALIDATION
       ========================================================= */

    .auth-v2-validation {

        display: block;

        margin-top: 4px;

        color: #d24d5a;

        font-size: 8px;
    }


    /* =========================================================
       REMEMBER ME
       ========================================================= */

    .auth-v2-check {

        display: inline-flex;

        align-items: center;

        gap: 8px;

        margin: 0 0 18px;

        color: #8a95a8;

        font-size: 10px;

        cursor: pointer;

        user-select: none;
    }


    .auth-v2-check input {

        appearance: none;

        -webkit-appearance: none;

        width: 16px;
        height: 16px;

        margin: 0;

        border: 1px solid #d3d9e2;

        border-radius: 5px;

        background: #ffffff;

        cursor: pointer;

        position: relative;

        transition:
            background 0.2s ease,
            border-color 0.2s ease;
    }


    .auth-v2-check input:checked {

        background:
            linear-gradient(
                135deg,
                #7658f2,
                #6142df
            );

        border-color: #6848e4;
    }


    .auth-v2-check input:checked::after {

        content: "✓";

        position: absolute;

        left: 50%;
        top: 50%;

        transform:
            translate(-50%, -54%);

        color: #ffffff;

        font-size: 9px;

        font-weight: 800;
    }


    /* =========================================================
       SIGN IN BUTTON
       ========================================================= */

    .auth-v2-button {

        width: 100%;

        height: 47px;

        display: flex;

        align-items: center;
        justify-content: center;

        gap: 8px;

        border: none;

        border-radius: 11px;

        background:
            linear-gradient(
                135deg,
                #7053ef,
                #5d48e7
            );

        color: #ffffff;

        font-family:
            'Inter',
            sans-serif;

        font-size: 12px;

        font-weight: 800;

        cursor: pointer;

        box-shadow:
            0 10px 22px
            rgba(101, 73, 232, 0.23);

        transition:
            transform 0.2s ease,
            box-shadow 0.2s ease,
            filter 0.2s ease;
    }


    .auth-v2-button::before {

        content: "→";

        width: 20px;
        height: 20px;

        display: inline-flex;

        align-items: center;
        justify-content: center;

        border-radius: 6px;

        background:
            rgba(255,255,255,0.15);

        font-size: 13px;

        transition:
            transform 0.2s ease;
    }


    .auth-v2-button:hover {

        transform: translateY(-2px);

        filter: brightness(1.03);

        box-shadow:
            0 14px 28px
            rgba(101, 73, 232, 0.29);
    }


    .auth-v2-button:hover::before {

        transform: translateX(3px);
    }


    .auth-v2-button:active {

        transform:
            translateY(0);
    }


    /* =========================================================
       FOOTER
       ========================================================= */

    .auth-v2-footer {

        position: relative;

        margin: 20px 0 0;

        padding-top: 17px;

        border-top: 1px solid #edf0f4;

        text-align: center;

        color: #929cad;

        font-size: 10px;
    }


    .auth-v2-footer a {

        color: #6046e2;

        text-decoration: none;

        font-weight: 800;

        transition:
            color 0.2s ease;
    }


    .auth-v2-footer a:hover {

        color: #4f36cc;

        text-decoration: underline;
    }


    /* =========================================================
       SECURITY NOTE
       ========================================================= */

    .auth-v2-security {

        display: flex;

        align-items: center;

        justify-content: center;

        gap: 6px;

        margin-top: 13px;

        color: #a0a8b7;

        font-size: 8px;
    }


    .auth-v2-security svg {

        width: 12px;
        height: 12px;

        color: #6c8edb;
    }


    /* =========================================================
       TABLET
       ========================================================= */

    @@media (max-width: 900px) {

        .auth-v2-page {

            min-height: 100vh;

            padding: 20px 25px;

        }


        .auth-v2-wrapper {

            max-width: 760px;

            min-height: 570px;

            transform: translateY(-5px);

        }


        .auth-v2-left {

            padding: 35px 30px;

        }


        .auth-v2-right {

            padding: 35px 35px;

        }


        .auth-v2-left-image {

            width: 200px;

            height: 200px;

        }


        .auth-v2-left-content h2 {

            font-size: 23px;

        }


        .auth-v2-form-header h1 {

            font-size: 28px;

        }

    }


    /* =========================================================
       MOBILE
       ========================================================= */

    @@media (max-width: 680px) {

        .auth-v2-page {

            min-height: 100vh;

            padding: 15px;

            overflow-y: auto;

        }


        .auth-v2-wrapper {

            display: flex;

            flex-direction: column;

            max-width: 470px;

            min-height: auto;

            transform: none;

            border-radius: 21px;

        }


        .auth-v2-left {

            padding: 28px 22px 25px;

        }


        .auth-v2-left-image {

            width: 135px;

            height: 135px;

            margin-bottom: 16px;

            padding: 8px;

            border-radius: 18px;

        }


        .auth-side-image {

            border-radius: 11px;

        }


        .auth-v2-brand-badge {

            margin-bottom: 10px;

        }


        .auth-v2-left-content h2 {

            font-size: 21px;

            margin-bottom: 8px;

        }


        .auth-v2-left-content p {

            font-size: 11px;

            line-height: 1.6;

        }


        .auth-v2-features {

            margin-top: 15px;

        }


        .auth-v2-right {

            padding: 30px 24px;

        }


        .auth-v2-form-header {

            margin-bottom: 21px;

        }


        .auth-v2-form-header h1 {

            font-size: 27px;

        }

    }


    /* =========================================================
       SMALL MOBILE
       ========================================================= */

    @@media (max-width: 400px) {

        .auth-v2-page {

            padding: 8px;

        }


        .auth-v2-wrapper {

            border-radius: 17px;

        }


        .auth-v2-left {

            padding: 24px 18px;

        }


        .auth-v2-right {

            padding: 27px 18px;

        }


        .auth-v2-left-image {

            width: 120px;

            height: 120px;

        }


        .auth-v2-features {

            display: none;

        }

    }

</style>


<div class="auth-v2-page">


    <div class="auth-v2-wrapper">


        <!-- =====================================================
             LEFT SIDE
             ===================================================== -->

        <div class="auth-v2-left">


            <div class="auth-v2-left-content">


                <div class="auth-v2-left-image">

                    <img src="~/image/login-image.jpg"
                         alt="BulBit Workspace"
                         class="auth-side-image" />

                </div>


                <div class="auth-v2-brand-badge">

                    <span class="auth-v2-brand-badge-icon">
                        B
                    </span>

                    BULBIT WORKSPACE

                </div>


                <h2>
                    Manage your work with ease
                </h2>


                <p>

                    Stay connected with your team,
                    manage tasks, track attendance and
                    keep everything organized in one place.

                </p>


                <div class="auth-v2-features">


                    <div class="auth-v2-feature">

                        <span class="auth-v2-feature-icon">
                            ✓
                        </span>

                        Team Management

                    </div>


                    <div class="auth-v2-feature">

                        <span class="auth-v2-feature-icon">
                            ◷
                        </span>

                        Attendance

                    </div>


                    <div class="auth-v2-feature">

                        <span class="auth-v2-feature-icon">
                            □
                        </span>

                        Task Tracking

                    </div>


                </div>


            </div>


        </div>


        <!-- =====================================================
             RIGHT SIDE
             ===================================================== -->

        <div class="auth-v2-right">


            <div class="auth-v2-form">


                <!-- HEADER -->

                <div class="auth-v2-form-header">

                    <h1>
                        Welcome back
                    </h1>

                    <p>
                        Sign in to continue to your dashboard.
                    </p>

                </div>


                <!-- VALIDATION -->

                @if (!ViewData.ModelState.IsValid)
                {

                    <div class="auth-v2-error"
                         asp-validation-summary="All">
                    </div>

                }


                <!-- LOGIN FORM -->

                <form asp-action="Login"
                      method="post">

                    @Html.AntiForgeryToken()


                    <input type="hidden"
                           name="returnUrl"
                           value="@ViewData["ReturnUrl"]" />


                    <!-- EMAIL -->

                    <div class="auth-v2-form-group">


                        <label asp-for="Email">
                            Email
                        </label>


                        <div class="auth-v2-input-wrapper">


                            <span class="auth-v2-input-icon">


                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8"
                                     stroke-linecap="round"
                                     stroke-linejoin="round">

                                    <rect x="3"
                                          y="5"
                                          width="18"
                                          height="14"
                                          rx="2">
                                    </rect>

                                    <path d="m3 7 9 6 9-6">
                                    </path>

                                </svg>


                            </span>


                            <input asp-for="Email"
                                   class="auth-v2-input"
                                   placeholder="name@example.com"
                                   autocomplete="email" />


                        </div>


                        <span asp-validation-for="Email"
                              class="auth-v2-validation">
                        </span>


                    </div>


                    <!-- PASSWORD -->

                    <div class="auth-v2-form-group">


                        <label asp-for="Password">
                            Password
                        </label>


                        <div class="auth-v2-input-wrapper">


                            <span class="auth-v2-input-icon">


                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8"
                                     stroke-linecap="round"
                                     stroke-linejoin="round">

                                    <rect x="5"
                                          y="10"
                                          width="14"
                                          height="10"
                                          rx="2">
                                    </rect>

                                    <path d="M8 10V7a4 4 0 0 1 8 0v3">
                                    </path>

                                    <circle cx="12"
                                            cy="15"
                                            r="1">
                                    </circle>

                                </svg>


                            </span>


                            <input asp-for="Password"
                                   id="loginPassword"
                                   class="auth-v2-input"
                                   type="password"
                                   placeholder="Enter your password"
                                   autocomplete="current-password"
                                   style="padding-right:48px;" />


                            <button type="button"
                                    class="auth-v2-password-toggle"
                                    id="passwordToggle"
                                    aria-label="Show password">


                                <svg id="eyeIcon"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8"
                                     stroke-linecap="round"
                                     stroke-linejoin="round">

                                    <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12z">
                                    </path>

                                    <circle cx="12"
                                            cy="12"
                                            r="2.5">
                                    </circle>

                                </svg>


                            </button>


                        </div>


                        <span asp-validation-for="Password"
                              class="auth-v2-validation">
                        </span>


                    </div>


                    <!-- REMEMBER ME -->

                    <label class="auth-v2-check">


                        <input asp-for="RememberMe" />


                        <span>
                            Remember me
                        </span>


                    </label>


                    <!-- SIGN IN -->

                    <button type="submit"
                            class="auth-v2-button">

                        Sign In

                    </button>


                </form>


                <!-- REGISTER -->

                <p class="auth-v2-footer">

                    Don't have an account?

                    <a asp-action="Register">
                        Create an account
                    </a>

                </p>


                <!-- SECURITY -->

                <div class="auth-v2-security">


                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <rect x="5"
                              y="10"
                              width="14"
                              height="10"
                              rx="2">
                        </rect>

                        <path d="M8 10V7a4 4 0 0 1 8 0v3">
                        </path>

                    </svg>


                    Secure workspace login


                </div>


            </div>


        </div>


    </div>


</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />


    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {


                const password =
                    document.getElementById(
                        "loginPassword"
                    );


                const toggle =
                    document.getElementById(
                        "passwordToggle"
                    );


                const eyeIcon =
                    document.getElementById(
                        "eyeIcon"
                    );


                if (!password || !toggle) {
                    return;
                }


                toggle.addEventListener(
                    "click",
                    function () {


                        const isPassword =
                            password.type === "password";


                        password.type =
                            isPassword
                                ? "text"
                                : "password";


                        toggle.setAttribute(
                            "aria-label",
                            isPassword
                                ? "Hide password"
                                : "Show password"
                        );


                        if (isPassword) {

                            eyeIcon.innerHTML = `
                                <path d="M3 3l18 18"></path>
                                <path d="M10.6 10.6a2 2 0 0 0 2.8 2.8"></path>
                                <path d="M9.9 5.2A10.8 10.8 0 0 1 12 5c6.5 0 10 7 10 7a17.2 17.2 0 0 1-3.1 3.8"></path>
                                <path d="M6.1 6.1C3.5 8.1 2 12 2 12s3.5 7 10 7c1.7 0 3.2-.4 4.5-1"></path>
                            `;

                        }
                        else {

                            eyeIcon.innerHTML = `
                                <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12z"></path>
                                <circle cx="12" cy="12" r="2.5"></circle>
                            `;

                        }

                    }
                );


            }
        );

    </script>

}