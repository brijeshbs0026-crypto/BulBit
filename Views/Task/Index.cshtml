@model List<AuthMvcApp.Models.TaskItem>

@{
    ViewData["Title"] = "Tasks";
    var employees = ViewBag.Employees as IEnumerable<AuthMvcApp.Models.Employee>;
}

<div class="task-page">

    <!-- HEADER -->
    <div class="task-header">

        <div>
            <div class="eyebrow">WORK MANAGEMENT</div>

            <h1>Task Management</h1>

            <p>Assign, track and manage employee tasks.</p>
        </div>

        @if (User.IsInRole("Admin"))
        {
            <button type="button"
                    class="btn primary"
                    onclick="openTaskModal()">
                + Assign New Task
            </button>
        }

    </div>


    <!-- FILTERS -->
    <div class="task-filters">

        <button type="button" class="task-filter active" onclick="filterTaskGrid('All', this)">
            All <span>@Model.Count</span>
        </button>

        <button type="button" class="task-filter" onclick="filterTaskGrid('Pending', this, true)">
            Pending
            <span>@Model.Count(x => x.Status == "Pending")</span>
        </button>

        <button type="button" class="task-filter" onclick="filterTaskGrid('In Progress', this, true)">
            In Progress
            <span>@Model.Count(x => x.Status == "In Progress")</span>
        </button>

        <button type="button" class="task-filter" onclick="filterTaskGrid('Completed', this, true)">
            Completed
            <span>@Model.Count(x => x.Status == "Completed")</span>
        </button>

    </div>


    <!-- TASK CARDS -->
    <div class="task-grid" id="taskGridContainer">

        @foreach (var task in Model)
        {
            var employeeName = task.Employee?.FullName ?? "Unknown";

            var initial = !string.IsNullOrWhiteSpace(employeeName)
            ? employeeName.Substring(0, 1).ToUpper()
            : "U";

            var priority = string.IsNullOrWhiteSpace(task.Priority)
            ? "Medium"
            : task.Priority;

            var status = string.IsNullOrWhiteSpace(task.Status)
            ? "Pending"
            : task.Status;

            <div class="task-card" data-status="@status">

                <!-- TOP -->
                <div class="task-card-top">

                    <span class="priority @priority.ToLowerInvariant()">
                        @priority
                    </span>

                    @if (User.IsInRole("Admin"))
                    {
                        <form asp-controller="Task"
                              asp-action="Delete"
                              asp-route-id="@task.Id"
                              method="post"
                              style="display:inline;"
                              onsubmit="return confirm('Are you sure you want to delete this task?');">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    title="Delete task"
                                    style="background: none; border: none; cursor: pointer; color: #ef4444; font-size: 0.9rem; padding: 0.2rem 0.4rem; border-radius: 4px;">
                                ✕ Delete
                            </button>
                        </form>
                    }
                    else
                    {
                        <span class="task-menu">
                            •••
                        </span>
                    }

                </div>


                <!-- TITLE -->
                <h2>
                    @task.Title
                </h2>


                <!-- DESCRIPTION -->
                <p class="task-description">
                    @(string.IsNullOrWhiteSpace(task.Description)
                                    ? "No description provided."
                                    : task.Description)
            </p>


                <!-- EMPLOYEE -->
                <div class="task-employee">

                    <div class="employee-avatar">
                        @initial
                    </div>

                    <span>
                        @employeeName
                    </span>

                @if (task.DueDate.HasValue)
                    {
                        <small>
                            Due @task.DueDate.Value.ToString("MMM dd")
                        </small>
                    }

                </div>


                <!-- PROGRESS -->
                <div class="progress-bar">

                    <div class="progress"
                         style="width: @(task.Progress)%;">
                    </div>

                </div>


                <!-- FOOTER -->
                <div class="task-footer">

                    <span>
                        @task.Progress% complete
                    </span>


                    @if (status == "Completed")
                    {
                        <!-- ALREADY COMPLETED -->

                        <span class="status completed">
                            Completed
                        </span>
                    }
                    else
                    {
                        <!-- MARK COMPLETE -->

                        <form asp-controller="Task"
                              asp-action="Complete"
                              method="post"
                              class="complete-form">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@task.Id" />

                            <button type="submit"
                                    class="status complete-button"
                                    onclick="return confirm('Mark this task as completed?');">

                                Mark Completed

                            </button>

                        </form>
                    }

                </div>

            </div>
        }


        <!-- EMPTY -->
        @if (!Model.Any())
        {
            <div class="empty-task">

                No tasks available.

                @if (User.IsInRole("Admin"))
                {
                    @:Click <strong>Assign New Task</strong> to create one.
                }

            </div>
        }

    </div>

</div>


<!-- ================================================= -->
<!-- ASSIGN TASK MODAL -->
<!-- ================================================= -->

@if (User.IsInRole("Admin"))
{
    <div id="taskModal" class="task-modal">

        <!-- BACKDROP -->
        <div class="task-modal-overlay"
             onclick="closeTaskModal()">
        </div>


        <!-- MODAL -->
        <div class="task-modal-content">

            <button type="button"
                    class="modal-close"
                    onclick="closeTaskModal()">
                ×
            </button>


            <h2>
                Assign New Task
            </h2>

            <p>
                Create and assign a task to an employee.
            </p>


            <form asp-controller="Task"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()


                <!-- TITLE + EMPLOYEE -->
                <div class="task-form-row">

                    <div class="form-group">

                        <label for="Title">
                            Task Title
                        </label>

                        <input id="Title"
                               type="text"
                               name="Title"
                               class="task-input"
                               placeholder="e.g. Build employee profile"
                               required />

                    </div>


                    <div class="form-group">

                        <label for="EmployeeId">
                            Assign To
                        </label>

                        <select id="EmployeeId"
                                name="EmployeeId"
                                class="task-input"
                                required>

                            <option value="">
                                Select employee
                            </option>

                            @if (employees != null)
                            {
                                foreach (var employee in employees)
                                {
                                    <option value="@employee.Id">
                                        @employee.FullName
                                    </option>
                                }
                            }

                        </select>

                    </div>

                </div>


                <!-- DESCRIPTION -->
                <div class="form-group">

                    <label for="Description">
                        Description
                    </label>

                    <textarea id="Description"
                              name="Description"
                              class="task-input task-textarea"
                              placeholder="Describe the task..."></textarea>

                </div>


                <!-- PRIORITY + DUE DATE -->
                <div class="task-form-row">

                    <div class="form-group">

                        <label for="Priority">
                            Priority
                        </label>

                        <select id="Priority"
                                name="Priority"
                                class="task-input">

                            <option value="High">
                                High
                            </option>

                            <option value="Medium" selected>
                                Medium
                            </option>

                            <option value="Low">
                                Low
                            </option>

                        </select>

                    </div>


                    <div class="form-group">

                        <label for="DueDate">
                            Due Date
                        </label>

                        <input id="DueDate"
                               type="date"
                               name="DueDate"
                               class="task-input" />

                    </div>

                </div>


                <!-- SUBMIT -->
                <button type="submit"
                        class="assign-task-btn">

                    Assign Task

                </button>

            </form>

        </div>

    </div>
}


<!-- ================================================= -->
<!-- STATUS FILTER TASKS MODAL -->
<!-- ================================================= -->
<div id="statusTasksModal" class="task-modal">

    <!-- BACKDROP -->
    <div class="task-modal-overlay" onclick="closeStatusTasksModal()"></div>

    <!-- MODAL CONTENT -->
    <div class="task-modal-content status-modal-dialog">

        <button type="button"
                class="modal-close"
                onclick="closeStatusTasksModal()">
            ×
        </button>

        <div class="status-modal-header">
            <div class="eyebrow" id="statusModalEyebrow">FILTERED TASKS</div>
            <div class="status-modal-title-row">
                <h2 id="statusModalTitle">Pending Tasks</h2>
                <span id="statusModalBadge" class="status-count-pill">0 Tasks</span>
            </div>
            <p id="statusModalSubtitle">Showing tasks filtered by status.</p>
        </div>

        <div id="statusModalBody" class="status-modal-body">
            <!-- Dynamic task items populated by JavaScript -->
        </div>

        <div class="status-modal-footer">
            <button type="button"
                    class="btn secondary"
                    onclick="closeStatusTasksModal()">
                Close
            </button>
        </div>

    </div>

</div>


@section Scripts {

    <script>
        // Serialized tasks for instant modal rendering
        const allTasks = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(t => new {
            id = t.Id,
            title = t.Title ?? "",
            description = string.IsNullOrWhiteSpace(t.Description) ? "No description provided." : t.Description,
            status = string.IsNullOrWhiteSpace(t.Status) ? "Pending" : t.Status,
            priority = string.IsNullOrWhiteSpace(t.Priority) ? "Medium" : t.Priority,
            employeeName = t.Employee?.FullName ?? "Unknown",
            initial = !string.IsNullOrWhiteSpace(t.Employee?.FullName) ? t.Employee.FullName.Substring(0, 1).ToUpper() : "U",
            dueDate = t.DueDate.HasValue ? t.DueDate.Value.ToString("MMM dd, yyyy") : "",
            progress = t.Progress
        })));

        // Get CSRF Token
        function getCsrfToken() {
            const tokenInput = document.querySelector("#csrfForm input[name='__RequestVerificationToken']") ||
                               document.querySelector("input[name='__RequestVerificationToken']");
            return tokenInput ? tokenInput.value : "";
        }

        // ==========================================
        // 1. FILTER TASK GRID & OPTIONALLY OPEN MODAL
        // ==========================================
        function filterTaskGrid(status, buttonEl, openModal = false) {
            // Update active filter button
            document.querySelectorAll(".task-filters .task-filter").forEach(btn => {
                btn.classList.remove("active");
            });
            if (buttonEl) {
                buttonEl.classList.add("active");
            }

            // Filter on-page cards
            const cards = document.querySelectorAll("#taskGridContainer .task-card");
            let visibleCount = 0;

            cards.forEach(card => {
                const cardStatus = (card.getAttribute("data-status") || "").trim().toLowerCase();
                const targetStatus = status.trim().toLowerCase();

                if (targetStatus === "all" || cardStatus === targetStatus) {
                    card.style.display = "";
                    visibleCount++;
                } else {
                    card.style.display = "none";
                }
            });

            // If user clicked Pending, Completed or In Progress, also open the modal
            if (openModal && status !== "All") {
                openStatusTasksModal(status);
            }
        }

        // ==========================================
        // 2. OPEN STATUS TASKS MODAL
        // ==========================================
        function openStatusTasksModal(status) {
            const modal = document.getElementById("statusTasksModal");
            const titleEl = document.getElementById("statusModalTitle");
            const badgeEl = document.getElementById("statusModalBadge");
            const subtitleEl = document.getElementById("statusModalSubtitle");
            const bodyEl = document.getElementById("statusModalBody");

            if (!modal || !bodyEl) return;

            const targetStatus = status.trim().toLowerCase();
            const filteredTasks = allTasks.filter(t => t.status.trim().toLowerCase() === targetStatus);

            titleEl.textContent = `${status} Tasks`;
            badgeEl.textContent = `${filteredTasks.length} ${filteredTasks.length === 1 ? 'Task' : 'Tasks'}`;
            subtitleEl.textContent = `Showing all tasks with status "${status}".`;

            if (filteredTasks.length === 0) {
                bodyEl.innerHTML = `
                    <div class="empty-status-state">
                        <div class="empty-state-icon">📋</div>
                        <h3>No ${status} Tasks</h3>
                        <p>There are currently no tasks marked as "${status}".</p>
                    </div>
                `;
            } else {
                let html = '<div class="status-modal-grid">';
                const csrf = getCsrfToken();

                filteredTasks.forEach(task => {
                    const priorityClass = (task.priority || 'medium').toLowerCase();
                    const isCompleted = task.status.toLowerCase() === 'completed';

                    html += `
                        <div class="status-task-item">
                            <div class="status-task-top">
                                <span class="priority ${priorityClass}">${task.priority}</span>
                                ${task.dueDate ? `<span class="status-due-date">📅 Due ${task.dueDate}</span>` : ''}
                            </div>

                            <h3 class="status-task-title">${escapeHtml(task.title)}</h3>
                            <p class="status-task-desc">${escapeHtml(task.description)}</p>

                            <div class="status-task-assignee">
                                <div class="employee-avatar">${task.initial}</div>
                                <span>${escapeHtml(task.employeeName)}</span>
                            </div>

                            <div class="status-progress-wrap">
                                <div class="status-progress-bar">
                                    <div class="status-progress-fill" style="width: ${task.progress}%;"></div>
                                </div>
                                <span class="status-progress-text">${task.progress}%</span>
                            </div>

                            <div class="status-task-actions">
                                ${isCompleted ? `
                                    <span class="status completed">✓ Completed</span>
                                ` : `
                                    <form action="/Task/Complete" method="post" style="margin:0;">
                                        <input type="hidden" name="__RequestVerificationToken" value="${csrf}" />
                                        <input type="hidden" name="id" value="${task.id}" />
                                        <button type="submit" class="status complete-button" onclick="return confirm('Mark this task as completed?');">
                                            ✓ Mark Completed
                                        </button>
                                    </form>
                                `}
                            </div>
                        </div>
                    `;
                });

                html += '</div>';
                bodyEl.innerHTML = html;
            }

            modal.classList.add("show");
            document.body.style.overflow = "hidden";
        }

        function closeStatusTasksModal() {
            const modal = document.getElementById("statusTasksModal");
            if (modal) {
                modal.classList.remove("show");
            }
            document.body.style.overflow = "";
        }

        function escapeHtml(text) {
            if (!text) return "";
            const div = document.createElement("div");
            div.textContent = text;
            return div.innerHTML;
        }

        // ==========================================
        // 3. ASSIGN TASK MODAL (ADMIN)
        // ==========================================
        function openTaskModal() {
            const modal = document.getElementById("taskModal");
            if (modal) {
                modal.classList.add("show");
                document.body.style.overflow = "hidden";
            }
        }

        function closeTaskModal() {
            const modal = document.getElementById("taskModal");
            if (modal) {
                modal.classList.remove("show");
                document.body.style.overflow = "";
            }
        }

        // Close any open modal using ESC
        document.addEventListener("keydown", function (event) {
            if (event.key === "Escape") {
                closeTaskModal();
                closeStatusTasksModal();
            }
        });
    </script>

}