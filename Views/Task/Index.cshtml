@model List<AuthMvcApp.Models.TaskItem>

@{
    ViewData["Title"] = "Tasks";
    var employees = ViewBag.Employees as IEnumerable<AuthMvcApp.Models.Employee>;
}


<!-- =========================================================
     ICONS
     ========================================================= -->

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />


<style>

    /* =========================================================
       TASK PAGE
       ========================================================= */

    .task-page {
        max-width: 1500px;
        margin: 0 auto;
        padding: 34px 40px 55px;
    }


    /* =========================================================
       HEADER
       ========================================================= */

    .task-header {
        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 25px;

        margin-bottom: 28px;
    }

    .task-title-wrapper {
        display: flex;
        align-items: center;
        gap: 17px;
    }

    .task-title-icon {
        width: 58px;
        height: 58px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 16px;

        background: linear-gradient(
            135deg,
            #7357f5,
            #6343e9
        );

        color: white;

        font-size: 24px;

        box-shadow:
            0 10px 25px rgba(103, 75, 235, 0.25);
    }

    .task-header h1 {
        margin: 3px 0 4px;

        color: #10182b;

        font-size: 36px;
        font-weight: 800;

        letter-spacing: -1px;
    }

    .task-header p {
        margin: 0;

        color: #8994a8;

        font-size: 14px;
    }

    .eyebrow {
        display: flex;
        align-items: center;

        gap: 6px;

        color: #6952ef;

        font-size: 11px;
        font-weight: 800;

        letter-spacing: 1.4px;
    }


    /* =========================================================
       BUTTONS
       ========================================================= */

    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;

        gap: 8px;

        border: none;

        border-radius: 12px;

        padding: 13px 19px;

        font-size: 13px;
        font-weight: 700;

        cursor: pointer;

        transition: all 0.22s ease;
    }

    .btn.primary {
        color: white;

        background: linear-gradient(
            135deg,
            #7659f5,
            #6544e8
        );

        box-shadow:
            0 9px 22px rgba(103, 75, 235, 0.22);
    }

    .btn.primary:hover {
        transform: translateY(-2px);

        box-shadow:
            0 14px 28px rgba(103, 75, 235, 0.30);
    }

    .btn.secondary {
        color: #536078;

        background: #f4f5f8;

        border: 1px solid #e4e7ed;
    }

    .btn.secondary:hover {
        background: #e9ebf0;
    }


    /* =========================================================
       FILTER BAR
       ========================================================= */

    .task-filters {
        display: flex;
        align-items: center;

        gap: 8px;

        margin-bottom: 22px;

        padding: 7px;

        width: fit-content;

        background: #f4f5f8;

        border: 1px solid #e7e9ef;

        border-radius: 13px;
    }

    .task-filter {
        display: inline-flex;
        align-items: center;

        gap: 8px;

        padding: 9px 13px;

        border: none;

        border-radius: 9px;

        background: transparent;

        color: #6e788c;

        font-size: 13px;
        font-weight: 650;

        cursor: pointer;

        transition: all 0.2s ease;
    }

    .task-filter span {
        min-width: 23px;
        height: 22px;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        border-radius: 7px;

        background: #e8eaf0;

        color: #727c90;

        font-size: 11px;
        font-weight: 800;
    }

    .task-filter:hover {
        color: #6548df;
    }

    .task-filter.active {
        color: #5e45d8;

        background: white;

        box-shadow:
            0 3px 10px rgba(30, 40, 70, 0.07);
    }

    .task-filter.active span {
        background: #eeeaff;

        color: #684be8;
    }


    /* =========================================================
       TASK GRID
       ========================================================= */

    .task-grid {
        display: grid;

        grid-template-columns:
            repeat(3, minmax(0, 1fr));

        gap: 18px;
    }


    /* =========================================================
       TASK CARD
       ========================================================= */

    .task-card {
        position: relative;

        display: flex;
        flex-direction: column;

        min-height: 285px;

        padding: 21px;

        background: #ffffff;

        border: 1px solid #e7eaf1;

        border-radius: 18px;

        box-shadow:
            0 7px 25px rgba(28, 38, 65, 0.055);

        transition:
            transform 0.22s ease,
            box-shadow 0.22s ease,
            border-color 0.22s ease;
    }

    .task-card:hover {
        transform: translateY(-3px);

        border-color: #dcd6ff;

        box-shadow:
            0 15px 35px rgba(28, 38, 65, 0.09);
    }


    /* =========================================================
       CARD TOP
       ========================================================= */

    .task-card-top {
        display: flex;
        align-items: center;
        justify-content: space-between;

        margin-bottom: 15px;
    }


    /* =========================================================
       PRIORITY
       ========================================================= */

    .priority {
        display: inline-flex;
        align-items: center;

        gap: 5px;

        padding: 6px 10px;

        border-radius: 8px;

        font-size: 11px;
        font-weight: 800;

        text-transform: capitalize;
    }

    .priority::before {
        content: "";

        width: 6px;
        height: 6px;

        border-radius: 50%;
    }

    .priority.high {
        color: #d94b59;

        background: #fff0f1;
    }

    .priority.high::before {
        background: #ed5b67;
    }

    .priority.medium {
        color: #c47b19;

        background: #fff7e8;
    }

    .priority.medium::before {
        background: #e5a43a;
    }

    .priority.low {
        color: #168867;

        background: #eafaf5;
    }

    .priority.low::before {
        background: #24b98b;
    }


    /* =========================================================
       DELETE / MENU
       ========================================================= */

    .task-delete-btn {
        display: inline-flex;
        align-items: center;
        gap: 5px;

        padding: 6px 8px;

        border: none;

        border-radius: 8px;

        background: transparent;

        color: #a0a8b7;

        font-size: 12px;

        cursor: pointer;

        transition: all 0.2s ease;
    }

    .task-delete-btn:hover {
        background: #fff0f1;

        color: #e24e5b;
    }

    .task-menu {
        color: #9ba4b4;

        font-size: 16px;

        letter-spacing: 2px;
    }


    /* =========================================================
       TASK TITLE
       ========================================================= */

    .task-card h2 {
        margin: 0 0 9px;

        color: #172036;

        font-size: 17px;
        font-weight: 800;

        line-height: 1.35;

        letter-spacing: -0.2px;
    }


    /* =========================================================
       DESCRIPTION
       ========================================================= */

    .task-description {
        display: -webkit-box;

        margin: 0 0 19px;

        color: #8490a4;

        font-size: 13px;

        line-height: 1.6;

        overflow: hidden;

        -webkit-box-orient: vertical;
        -webkit-line-clamp: 3;
    }


    /* =========================================================
       EMPLOYEE
       ========================================================= */

    .task-employee {
        display: flex;
        align-items: center;

        gap: 9px;

        margin-top: auto;

        padding-top: 14px;

        border-top: 1px solid #f0f1f5;

        color: #34405a;

        font-size: 13px;
        font-weight: 650;
    }

    .task-employee::before {
        content: " ";

        width: 3px;
        height: 24px;

        margin-right: 2px;

        border-radius: 5px;

        background: #eeeaff;
    }

    .employee-avatar {
        width: 34px;
        height: 34px;

        display: flex;
        align-items: center;
        justify-content: center;

        flex-shrink: 0;

        border-radius: 10px;

        background: linear-gradient(
            135deg,
            #e9e3ff,
            #d8d0ff
        );

        color: #684be8;

        font-size: 12px;
        font-weight: 800;
    }

    .task-employee small {
        margin-left: auto;

        color: #8c96a9;

        font-size: 11px;
        font-weight: 600;
    }


    /* =========================================================
       PROGRESS
       ========================================================= */

    .progress-bar {
        width: 100%;
        height: 7px;

        margin-top: 17px;

        overflow: hidden;

        border-radius: 10px;

        background: #edf0f5;
    }

    .progress {
        height: 100%;

        border-radius: inherit;

        background: linear-gradient(
            90deg,
            #7458f3,
            #9a87fa
        );

        transition: width 0.3s ease;
    }


    /* =========================================================
       FOOTER
       ========================================================= */

    .task-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 10px;

        margin-top: 12px;
    }

    .task-footer > span:first-child {
        color: #8994a8;

        font-size: 11px;
        font-weight: 700;
    }


    /* =========================================================
       STATUS
       ========================================================= */

    .status {
        display: inline-flex;
        align-items: center;

        gap: 5px;

        padding: 6px 10px;

        border-radius: 8px;

        font-size: 11px;
        font-weight: 750;
    }

    .status.completed {
        color: #128765;

        background: #e9faf4;

        border: 1px solid #c9f1e3;
    }

    .complete-button {
        border: 1px solid #dcd6ff;

        background: #f3f0ff;

        color: #6548df;

        cursor: pointer;

        transition: all 0.2s ease;
    }

    .complete-button:hover {
        background: #e8e2ff;

        transform: translateY(-1px);
    }


    /* =========================================================
       EMPTY STATE
       ========================================================= */

    .empty-task {
        grid-column: 1 / -1;

        padding: 75px 20px;

        text-align: center;

        color: #8994a8;

        background: white;

        border: 1px solid #e7eaf1;

        border-radius: 18px;
    }

    .empty-task::before {
        content: "✓";

        width: 65px;
        height: 65px;

        margin: 0 auto 15px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 19px;

        background: #f1efff;

        color: #7357ee;

        font-size: 25px;
        font-weight: 800;
    }


    /* =========================================================
       PAGINATION
       ========================================================= */

    .grid-pagination,
    .modal-pagination {
        box-sizing: border-box;

        border: 1px solid #e6e9f0 !important;

        border-radius: 13px !important;

        background: white !important;

        box-shadow:
            0 5px 18px rgba(28, 38, 65, 0.045) !important;
    }

    .pagination-info {
        color: #7d8799 !important;

        font-size: 12px !important;
    }

    .pagination-controls {
        display: inline-flex !important;

        align-items: center !important;

        flex-direction: row !important;

        gap: 6px !important;
    }

    .page-btn,
    .page-num {
        min-width: 34px;
        height: 34px;

        display: inline-flex !important;

        align-items: center !important;
        justify-content: center !important;

        border: 1px solid #e2e5ec;

        border-radius: 8px;

        background: white;

        color: #657086;

        font-size: 12px;
        font-weight: 700;

        cursor: pointer;

        transition: all 0.2s ease;
    }

    .page-btn {
        padding: 0 11px;
    }

    .page-btn:hover:not(:disabled),
    .page-num:hover {
        border-color: #d5ceff;

        background: #f5f2ff;

        color: #6548df;
    }

    .page-btn:disabled {
        opacity: 0.4;

        cursor: not-allowed;
    }

    .page-num.active {
        border-color: #7659f5;

        background: #7659f5;

        color: white;
    }


    /* =========================================================
       MODAL BASE
       ========================================================= */

    .task-modal {
        position: fixed;

        inset: 0;

        z-index: 9999;

        display: none;

        align-items: center;
        justify-content: center;
    }

    .task-modal.show {
        display: flex;
    }

    .task-modal-overlay {
        position: absolute;

        inset: 0;

        background: rgba(15, 23, 42, 0.48);

        backdrop-filter: blur(5px);
    }

    .task-modal-content {
        position: relative;

        z-index: 2;

        width: min(700px, calc(100% - 30px));

        max-height: 90vh;

        overflow-y: auto;

        padding: 30px;

        background: white;

        border: 1px solid #e5e8ef;

        border-radius: 22px;

        box-shadow:
            0 30px 80px rgba(15, 23, 42, 0.22);

        animation: taskModalIn 0.2s ease;
    }

    @@keyframes taskModalIn {

        from {
            opacity: 0;
            transform: translateY(12px) scale(0.98);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }

    }


    /* =========================================================
       MODAL CLOSE
       ========================================================= */

    .modal-close {
        position: absolute;

        top: 18px;
        right: 18px;

        width: 34px;
        height: 34px;

        display: flex;
        align-items: center;
        justify-content: center;

        border: 1px solid #e5e8ef;

        border-radius: 9px;

        background: white;

        color: #7d8799;

        font-size: 20px;

        cursor: pointer;

        transition: all 0.2s ease;
    }

    .modal-close:hover {
        background: #fff1f2;

        border-color: #ffd7dc;

        color: #df4d5b;
    }

    .task-modal-content > h2 {
        margin: 0 0 7px;

        color: #172036;

        font-size: 24px;
        font-weight: 800;
    }

    .task-modal-content > p {
        margin: 0 0 25px;

        color: #8994a8;

        font-size: 13px;
    }


    /* =========================================================
       FORM
       ========================================================= */

    .task-form-row {
        display: grid;

        grid-template-columns:
            repeat(2, minmax(0, 1fr));

        gap: 17px;
    }

    .form-group {
        margin-bottom: 18px;
    }

    .form-group label {
        display: block;

        margin-bottom: 7px;

        color: #34405a;

        font-size: 12px;
        font-weight: 750;
    }

    .task-input {
        box-sizing: border-box;

        width: 100%;

        min-height: 44px;

        padding: 10px 12px;

        border: 1px solid #dfe4ed;

        border-radius: 10px;

        outline: none;

        background: #fafbfe;

        color: #263148;

        font-family: inherit;

        font-size: 13px;

        transition: all 0.2s ease;
    }

    .task-input:focus {
        border-color: #7659f5;

        background: white;

        box-shadow:
            0 0 0 4px rgba(118, 89, 245, 0.08);
    }

    .task-textarea {
        min-height: 110px;

        resize: vertical;
    }

    .assign-task-btn {
        width: 100%;

        height: 47px;

        border: none;

        border-radius: 11px;

        background: linear-gradient(
            135deg,
            #7659f5,
            #6544e8
        );

        color: white;

        font-size: 13px;
        font-weight: 750;

        cursor: pointer;

        box-shadow:
            0 9px 22px rgba(103, 75, 235, 0.2);

        transition: all 0.2s ease;
    }

    .assign-task-btn:hover {
        transform: translateY(-1px);

        box-shadow:
            0 13px 27px rgba(103, 75, 235, 0.28);
    }


    /* =========================================================
       STATUS MODAL
       ========================================================= */

    .status-modal-dialog {
        width: min(900px, calc(100% - 30px));
    }

    .status-modal-header {
        padding-right: 35px;

        margin-bottom: 20px;
    }

    .status-modal-title-row {
        display: flex;
        align-items: center;

        gap: 10px;

        margin-top: 5px;
    }

    .status-modal-title-row h2 {
        margin: 0;

        color: #172036;

        font-size: 24px;
        font-weight: 800;
    }

    .status-count-pill {
        padding: 5px 9px;

        border-radius: 8px;

        background: #f0edff;

        color: #6548df;

        font-size: 11px;
        font-weight: 800;
    }

    .status-modal-header p {
        margin: 7px 0 0;

        color: #8994a8;

        font-size: 13px;
    }

    .status-modal-body {
        max-height: 53vh;

        overflow-y: auto;

        padding-right: 4px;
    }

    .status-modal-grid {
        display: grid;

        grid-template-columns:
            repeat(2, minmax(0, 1fr));

        gap: 14px;
    }

    .status-task-item {
        padding: 17px;

        border: 1px solid #e7eaf1;

        border-radius: 15px;

        background: #fbfcfe;

        transition: all 0.2s ease;
    }

    .status-task-item:hover {
        background: white;

        border-color: #ddd7ff;

        box-shadow:
            0 8px 22px rgba(30, 40, 70, 0.06);
    }

    .status-task-top {
        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 10px;

        margin-bottom: 11px;
    }

    .status-due-date {
        color: #8b95a7;

        font-size: 10px;
        font-weight: 650;
    }

    .status-task-title {
        margin: 0 0 7px;

        color: #1b253a;

        font-size: 15px;
        font-weight: 800;
    }

    .status-task-desc {
        display: -webkit-box;

        margin: 0 0 13px;

        color: #8792a5;

        font-size: 12px;

        line-height: 1.5;

        overflow: hidden;

        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
    }

    .status-task-assignee {
        display: flex;
        align-items: center;

        gap: 8px;

        color: #3d4960;

        font-size: 12px;
        font-weight: 700;
    }

    .status-task-assignee .employee-avatar {
        width: 30px;
        height: 30px;

        border-radius: 9px;

        font-size: 11px;
    }

    .status-progress-wrap {
        display: flex;
        align-items: center;

        gap: 8px;

        margin-top: 13px;
    }

    .status-progress-bar {
        flex: 1;

        height: 6px;

        overflow: hidden;

        border-radius: 10px;

        background: #e9ecf2;
    }

    .status-progress-fill {
        height: 100%;

        border-radius: inherit;

        background: linear-gradient(
            90deg,
            #7659f5,
            #9b89fa
        );
    }

    .status-progress-text {
        color: #7d8799;

        font-size: 10px;
        font-weight: 750;
    }

    .status-task-actions {
        display: flex;
        justify-content: flex-end;

        margin-top: 13px;
    }

    .empty-status-state {
        padding: 55px 20px;

        text-align: center;

        border: 1px dashed #dfe3eb;

        border-radius: 15px;

        background: #fafbfe;
    }

    .empty-state-icon {
        font-size: 32px;

        margin-bottom: 10px;
    }

    .empty-status-state h3 {
        margin: 0 0 6px;

        color: #263148;

        font-size: 17px;
    }

    .empty-status-state p {
        margin: 0;

        color: #8b95a7;

        font-size: 12px;
    }

    .status-modal-footer {
        display: flex;
        justify-content: flex-end;

        margin-top: 20px;

        padding-top: 17px;

        border-top: 1px solid #edf0f5;
    }


    /* =========================================================
       RESPONSIVE - TABLET
       ========================================================= */

    @@media (max-width: 1100px) {

        .task-grid {
            grid-template-columns:
                repeat(2, minmax(0, 1fr));
        }

        .task-page {
            padding: 28px 25px 45px;
        }

    }


    /* =========================================================
       RESPONSIVE - SMALL TABLET
       ========================================================= */

    @@media (max-width: 800px) {

        .task-header {
            align-items: flex-start;

            flex-direction: column;
        }

        .task-header .btn {
            width: 100%;
        }

        .task-grid {
            grid-template-columns: 1fr;
        }

        .status-modal-grid {
            grid-template-columns: 1fr;
        }

    }


    /* =========================================================
       RESPONSIVE - MOBILE
       ========================================================= */

    @@media (max-width: 600px) {

        .task-page {
            padding: 22px 15px 40px;
        }

        .task-header h1 {
            font-size: 29px;
        }

        .task-title-icon {
            width: 50px;
            height: 50px;

            font-size: 21px;
        }

        .task-title-wrapper {
            gap: 13px;
        }

        .task-filters {
            width: 100%;

            overflow-x: auto;
        }

        .task-filter {
            white-space: nowrap;
        }

        .task-form-row {
            grid-template-columns: 1fr;
        }

        .task-modal-content {
            padding: 23px 18px;
        }

        .status-modal-title-row {
            align-items: flex-start;
            flex-direction: column;
        }

    }

</style>


<div class="task-page">


    <!-- =====================================================
         HEADER
         ===================================================== -->

    <div class="task-header">

        <div class="task-title-wrapper">

            <div class="task-title-icon">
                <i class="bi bi-kanban-fill"></i>
            </div>

            <div>

                <div class="eyebrow">
                    <i class="bi bi-briefcase-fill"></i>
                    WORK MANAGEMENT
                </div>

                <h1>Task Management</h1>

                <p>
                    Assign, track and manage employee tasks.
                </p>

            </div>

        </div>


        @if (User.IsInRole("Admin"))
        {
            <button type="button"
                    class="btn primary"
                    onclick="openTaskModal()">

                <i class="bi bi-plus-lg"></i>

                Assign New Task

            </button>
        }

    </div>


    <!-- =====================================================
         FILTERS
         ===================================================== -->

    <div class="task-filters">

        <button type="button"
                class="task-filter active"
                onclick="filterTaskGrid('All', this)">

            <i class="bi bi-grid-fill"></i>

            All

            <span>
                @Model.Count
            </span>

        </button>


        <button type="button"
                class="task-filter"
                onclick="filterTaskGrid('Pending', this, true)">

            <i class="bi bi-clock"></i>

            Pending

            <span>
                @Model.Count(x => x.Status == "Pending")
            </span>

        </button>


        <button type="button"
                class="task-filter"
                onclick="filterTaskGrid('In Progress', this, true)">

            <i class="bi bi-arrow-repeat"></i>

            In Progress

            <span>
                @Model.Count(x => x.Status == "In Progress")
            </span>

        </button>


        <button type="button"
                class="task-filter"
                onclick="filterTaskGrid('Completed', this, true)">

            <i class="bi bi-check-circle"></i>

            Completed

            <span>
                @Model.Count(x => x.Status == "Completed")
            </span>

        </button>

    </div>


    <!-- =====================================================
         TASK CARDS
         ===================================================== -->

    <div class="task-grid"
         id="taskGridContainer">


        @foreach (var task in Model)
        {

            var employeeName =
                task.Employee?.FullName ?? "Unknown";

            var initial =
                !string.IsNullOrWhiteSpace(employeeName)
                    ? employeeName.Substring(0, 1).ToUpper()
                    : "U";

            var priority =
                string.IsNullOrWhiteSpace(task.Priority)
                    ? "Medium"
                    : task.Priority;

            var status =
                string.IsNullOrWhiteSpace(task.Status)
                    ? "Pending"
                    : task.Status;


            <div class="task-card"
                 data-status="@status">


                <!-- CARD TOP -->

                <div class="task-card-top">

                    <span class="priority @priority.ToLowerInvariant()">
                        @priority
                    </span>


                    @if (User.IsInRole("Admin"))
                    {

                        <form asp-controller="Task"
                              asp-action="Delete"
                              asp-route-id="@task.Id"
                              method="post"
                              style="display:inline;"
                              onsubmit="return confirm('Are you sure you want to delete this task?');">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    title="Delete task"
                                    class="task-delete-btn">

                                <i class="bi bi-trash3"></i>

                                Delete

                            </button>

                        </form>

                    }
                    else
                    {

                        <span class="task-menu">
                            •••
                        </span>

                    }

                </div>


                <!-- TITLE -->

                <h2>
                    @task.Title
                </h2>


                <!-- DESCRIPTION -->

                <p class="task-description">

                    @(string.IsNullOrWhiteSpace(task.Description)
                        ? "No description provided."
                        : task.Description)

                </p>


                <!-- EMPLOYEE -->

                <div class="task-employee">

                    <div class="employee-avatar">
                        @initial
                    </div>

                    <span>
                        @employeeName
                    </span>


                    @if (task.DueDate.HasValue)
                    {

                        <small>

                            <i class="bi bi-calendar3"></i>

                            Due
                            @task.DueDate.Value.ToString("MMM dd")

                        </small>

                    }

                </div>


                <!-- PROGRESS -->

                <div class="progress-bar">

                    <div class="progress"
                         style="width: @(task.Progress)%;">

                    </div>

                </div>


                <!-- FOOTER -->

                <div class="task-footer">

                    <span>
                        @task.Progress% complete
                    </span>


                    @if (status == "Completed")
                    {

                        <span class="status completed">

                            <i class="bi bi-check-circle-fill"></i>

                            Completed

                        </span>

                    }
                    else
                    {

                        <form asp-controller="Task"
                              asp-action="Complete"
                              method="post"
                              class="complete-form">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@task.Id" />

                            <button type="submit"
                                    class="status complete-button"
                                    onclick="return confirm('Mark this task as completed?');">

                                <i class="bi bi-check2"></i>

                                Mark Completed

                            </button>

                        </form>

                    }

                </div>

            </div>

        }


        <!-- EMPTY -->

        @if (!Model.Any())
        {

            <div class="empty-task">

                No tasks available.

                @if (User.IsInRole("Admin"))
                {
                    @: Click <strong>Assign New Task</strong> to create one.
                }

            </div>

        }

    </div>


    <!-- =====================================================
         MAIN GRID PAGINATION
         ===================================================== -->

    <div class="grid-pagination"
         id="gridPagination"
         style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px; margin-top:24px; padding:14px 20px;">

        <span class="pagination-info"
              id="gridPaginationInfo">

            Showing 1-6 of @Model.Count tasks

        </span>


        <div class="pagination-controls">

            <button type="button"
                    class="page-btn"
                    id="gridPrevBtn"
                    onclick="changeGridPage(-1)">

                ‹ Prev

            </button>


            <div class="page-numbers"
                 id="gridPageNumbers">
            </div>


            <button type="button"
                    class="page-btn"
                    id="gridNextBtn"
                    onclick="changeGridPage(1)">

                Next ›

            </button>

        </div>

    </div>

</div>


<!-- =========================================================
     ASSIGN TASK MODAL
     ========================================================= -->

@if (User.IsInRole("Admin"))
{

    <div id="taskModal"
         class="task-modal">


        <!-- BACKDROP -->

        <div class="task-modal-overlay"
             onclick="closeTaskModal()">
        </div>


        <!-- MODAL -->

        <div class="task-modal-content">


            <button type="button"
                    class="modal-close"
                    onclick="closeTaskModal()">

                ×

            </button>


            <h2>
                Assign New Task
            </h2>

            <p>
                Create and assign a task to an employee.
            </p>


            <form asp-controller="Task"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()


                <!-- TITLE + EMPLOYEE -->

                <div class="task-form-row">


                    <div class="form-group">

                        <label for="Title">
                            Task Title
                        </label>

                        <input id="Title"
                               type="text"
                               name="Title"
                               class="task-input"
                               placeholder="e.g. Build employee profile"
                               required />

                    </div>


                    <div class="form-group">

                        <label for="EmployeeId">
                            Assign To
                        </label>

                        <select id="EmployeeId"
                                name="EmployeeId"
                                class="task-input"
                                required>

                            <option value="">
                                Select employee
                            </option>


                            @if (employees != null)
                            {

                                foreach (var employee in employees)
                                {

                                    <option value="@employee.Id">
                                        @employee.FullName
                                    </option>

                                }

                            }

                        </select>

                    </div>

                </div>


                <!-- DESCRIPTION -->

                <div class="form-group">

                    <label for="Description">
                        Description
                    </label>

                    <textarea id="Description"
                              name="Description"
                              class="task-input task-textarea"
                              placeholder="Describe the task..."></textarea>

                </div>


                <!-- PRIORITY + DUE DATE -->

                <div class="task-form-row">


                    <div class="form-group">

                        <label for="Priority">
                            Priority
                        </label>

                        <select id="Priority"
                                name="Priority"
                                class="task-input">

                            <option value="High">
                                High
                            </option>

                            <option value="Medium" selected>
                                Medium
                            </option>

                            <option value="Low">
                                Low
                            </option>

                        </select>

                    </div>


                    <div class="form-group">

                        <label for="DueDate">
                            Due Date
                        </label>

                        <input id="DueDate"
                               type="date"
                               name="DueDate"
                               class="task-input" />

                    </div>

                </div>


                <!-- SUBMIT -->

                <button type="submit"
                        class="assign-task-btn">

                    <i class="bi bi-check2-circle"></i>

                    Assign Task

                </button>

            </form>

        </div>

    </div>

}


<!-- =========================================================
     STATUS FILTER TASKS MODAL
     ========================================================= -->

<div id="statusTasksModal"
     class="task-modal">


    <!-- BACKDROP -->

    <div class="task-modal-overlay"
         onclick="closeStatusTasksModal()">
    </div>


    <!-- MODAL -->

    <div class="task-modal-content status-modal-dialog">


        <button type="button"
                class="modal-close"
                onclick="closeStatusTasksModal()">

            ×

        </button>


        <div class="status-modal-header">

            <div class="eyebrow"
                 id="statusModalEyebrow">

                <i class="bi bi-filter-circle"></i>

                FILTERED TASKS

            </div>


            <div class="status-modal-title-row">

                <h2 id="statusModalTitle">
                    Pending Tasks
                </h2>

                <span id="statusModalBadge"
                      class="status-count-pill">

                    0 Tasks

                </span>

            </div>


            <p id="statusModalSubtitle">
                Showing tasks filtered by status.
            </p>

        </div>


        <div id="statusModalBody"
             class="status-modal-body">

            <!-- Dynamic task items populated by JavaScript -->

        </div>


        <!-- MODAL PAGINATION -->

        <div class="modal-pagination"
             id="statusModalPagination"
             style="display:none;">

            <span class="pagination-info"
                  id="statusPaginationInfo">

                Showing 1-4 of 0 tasks

            </span>


            <div class="pagination-controls">

                <button type="button"
                        class="page-btn"
                        id="modalPrevBtn"
                        onclick="changeStatusPage(-1)">

                    ‹ Prev

                </button>


                <div class="page-numbers"
                     id="modalPageNumbers">
                </div>


                <button type="button"
                        class="page-btn"
                        id="modalNextBtn"
                        onclick="changeStatusPage(1)">

                    Next ›

                </button>

            </div>

        </div>


        <div class="status-modal-footer">

            <button type="button"
                    class="btn secondary"
                    onclick="closeStatusTasksModal()">

                <i class="bi bi-x-lg"></i>

                Close

            </button>

        </div>

    </div>

</div>


@section Scripts {

<script>

    // =========================================================
    // SERIALIZED TASKS
    // =========================================================

    const allTasks =
        @Html.Raw(
            System.Text.Json.JsonSerializer.Serialize(
                Model.Select(t => new
                {
                    id = t.Id,
                    title = t.Title ?? "",
                    description = string.IsNullOrWhiteSpace(t.Description)
                        ? "No description provided."
                        : t.Description,
                    status = string.IsNullOrWhiteSpace(t.Status)
                        ? "Pending"
                        : t.Status,
                    priority = string.IsNullOrWhiteSpace(t.Priority)
                        ? "Medium"
                        : t.Priority,
                    employeeName = t.Employee?.FullName ?? "Unknown",
                    initial = !string.IsNullOrWhiteSpace(t.Employee?.FullName)
                        ? t.Employee.FullName.Substring(0, 1).ToUpper()
                        : "U",
                    dueDate = t.DueDate.HasValue
                        ? t.DueDate.Value.ToString("MMM dd, yyyy")
                        : "",
                    progress = t.Progress
                })
            )
        );


    // =========================================================
    // CSRF TOKEN
    // =========================================================

    function getCsrfToken() {

        const tokenInput =
            document.querySelector(
                "#csrfForm input[name='__RequestVerificationToken']"
            ) ||
            document.querySelector(
                "input[name='__RequestVerificationToken']"
            );

        return tokenInput
            ? tokenInput.value
            : "";

    }


    // =========================================================
    // MAIN GRID FILTERING + PAGINATION
    // =========================================================

    let currentGridFilter = "all";

    let gridCurrentPage = 1;

    const gridPageSize = 6;


    function getFilteredGridCards() {

        const cards =
            Array.from(
                document.querySelectorAll(
                    "#taskGridContainer .task-card"
                )
            );

        const targetStatus =
            currentGridFilter.trim().toLowerCase();


        return cards.filter(card => {

            const cardStatus =
                (
                    card.getAttribute("data-status") || ""
                )
                .trim()
                .toLowerCase();


            return targetStatus === "all" ||
                   cardStatus === targetStatus;

        });

    }


    function renderGridPage() {

        const allCards =
            Array.from(
                document.querySelectorAll(
                    "#taskGridContainer .task-card"
                )
            );


        const filteredCards =
            getFilteredGridCards();


        const totalItems =
            filteredCards.length;


        const totalPages =
            Math.ceil(totalItems / gridPageSize) || 1;


        if (gridCurrentPage > totalPages)
            gridCurrentPage = totalPages;


        if (gridCurrentPage < 1)
            gridCurrentPage = 1;


        const startIndex =
            (gridCurrentPage - 1) * gridPageSize;


        const endIndex =
            Math.min(
                startIndex + gridPageSize,
                totalItems
            );


        allCards.forEach(
            c => c.style.display = "none"
        );


        for (
            let i = startIndex;
            i < endIndex;
            i++
        ) {

            if (filteredCards[i]) {

                filteredCards[i].style.display = "";

            }

        }


        const paginationEl =
            document.getElementById(
                "gridPagination"
            );


        const infoEl =
            document.getElementById(
                "gridPaginationInfo"
            );


        const prevBtn =
            document.getElementById(
                "gridPrevBtn"
            );


        const nextBtn =
            document.getElementById(
                "gridNextBtn"
            );


        const pageNumbersEl =
            document.getElementById(
                "gridPageNumbers"
            );


        if (!paginationEl)
            return;


        if (totalItems <= gridPageSize) {

            if (totalItems === 0) {

                infoEl.textContent =
                    "No tasks found";

            }
            else {

                infoEl.textContent =
                    `Showing all ${totalItems} tasks`;

            }


            prevBtn.disabled = true;

            nextBtn.disabled = true;


            pageNumbersEl.innerHTML =
                totalItems > 0
                    ? `<button type="button" class="page-num active">1</button>`
                    : "";


            return;

        }


        infoEl.textContent =
            `Showing ${startIndex + 1}-${endIndex} of ${totalItems} tasks`;


        prevBtn.disabled =
            gridCurrentPage === 1;


        nextBtn.disabled =
            gridCurrentPage === totalPages;


        let pagesHtml = "";


        for (
            let p = 1;
            p <= totalPages;
            p++
        ) {

            pagesHtml +=
                `<button type="button"
                         class="page-num ${p === gridCurrentPage ? "active" : ""}"
                         onclick="goToGridPage(${p})">
                    ${p}
                 </button>`;

        }


        pageNumbersEl.innerHTML =
            pagesHtml;

    }


    function changeGridPage(delta) {

        gridCurrentPage += delta;

        renderGridPage();


        document
            .getElementById("taskGridContainer")
            ?.scrollIntoView({
                behavior: "smooth",
                block: "nearest"
            });

    }


    function goToGridPage(page) {

        gridCurrentPage = page;

        renderGridPage();


        document
            .getElementById("taskGridContainer")
            ?.scrollIntoView({
                behavior: "smooth",
                block: "nearest"
            });

    }


    function filterTaskGrid(
        status,
        buttonEl,
        openModal = false
    ) {

        currentGridFilter =
            status;


        gridCurrentPage =
            1;


        document
            .querySelectorAll(
                ".task-filters .task-filter"
            )
            .forEach(btn => {

                btn.classList.remove("active");

            });


        if (buttonEl) {

            buttonEl.classList.add("active");

        }


        renderGridPage();


        if (
            openModal &&
            status !== "All"
        ) {

            openStatusTasksModal(status);

        }

    }


    // =========================================================
    // STATUS TASK MODAL
    // =========================================================

    let currentModalTasks = [];

    let modalCurrentPage = 1;

    const modalPageSize = 4;

    let currentModalStatus = "";


    function openStatusTasksModal(status) {

        currentModalStatus =
            status;


        modalCurrentPage =
            1;


        const targetStatus =
            status.trim().toLowerCase();


        currentModalTasks =
            allTasks.filter(
                t =>
                    t.status
                        .trim()
                        .toLowerCase()
                    === targetStatus
            );


        const modal =
            document.getElementById(
                "statusTasksModal"
            );


        const titleEl =
            document.getElementById(
                "statusModalTitle"
            );


        const badgeEl =
            document.getElementById(
                "statusModalBadge"
            );


        const subtitleEl =
            document.getElementById(
                "statusModalSubtitle"
            );


        if (!modal)
            return;


        titleEl.textContent =
            `${status} Tasks`;


        badgeEl.textContent =
            `${currentModalTasks.length} ${
                currentModalTasks.length === 1
                    ? "Task"
                    : "Tasks"
            }`;


        subtitleEl.textContent =
            `Showing all tasks with status "${status}".`;


        renderStatusModalPage();


        modal.classList.add("show");


        document.body.style.overflow =
            "hidden";

    }


    function renderStatusModalPage() {

        const bodyEl =
            document.getElementById(
                "statusModalBody"
            );


        const paginationEl =
            document.getElementById(
                "statusModalPagination"
            );


        const infoEl =
            document.getElementById(
                "statusPaginationInfo"
            );


        const prevBtn =
            document.getElementById(
                "modalPrevBtn"
            );


        const nextBtn =
            document.getElementById(
                "modalNextBtn"
            );


        const pageNumbersEl =
            document.getElementById(
                "modalPageNumbers"
            );


        if (!bodyEl)
            return;


        if (currentModalTasks.length === 0) {

            bodyEl.innerHTML = `

                <div class="empty-status-state">

                    <div class="empty-state-icon">
                        <i class="bi bi-clipboard-x"></i>
                    </div>

                    <h3>
                        No ${currentModalStatus} Tasks
                    </h3>

                    <p>
                        There are currently no tasks marked as
                        "${currentModalStatus}".
                    </p>

                </div>

            `;


            if (paginationEl)
                paginationEl.style.display =
                    "none";


            return;

        }


        const totalItems =
            currentModalTasks.length;


        const totalPages =
            Math.ceil(
                totalItems / modalPageSize
            ) || 1;


        if (modalCurrentPage > totalPages)
            modalCurrentPage = totalPages;


        if (modalCurrentPage < 1)
            modalCurrentPage = 1;


        const startIndex =
            (modalCurrentPage - 1) *
            modalPageSize;


        const endIndex =
            Math.min(
                startIndex + modalPageSize,
                totalItems
            );


        const pageItems =
            currentModalTasks.slice(
                startIndex,
                endIndex
            );


        let html =
            '<div class="status-modal-grid">';


        const csrf =
            getCsrfToken();


        pageItems.forEach(task => {

            const priorityClass =
                (
                    task.priority ||
                    "medium"
                ).toLowerCase();


            const isCompleted =
                task.status
                    .toLowerCase()
                === "completed";


            html += `

                <div class="status-task-item">

                    <div class="status-task-top">

                        <span class="priority ${priorityClass}">
                            ${escapeHtml(task.priority)}
                        </span>

                        ${
                            task.dueDate
                                ? `
                                    <span class="status-due-date">

                                        <i class="bi bi-calendar3"></i>

                                        Due
                                        ${escapeHtml(task.dueDate)}

                                    </span>
                                  `
                                : ""
                        }

                    </div>


                    <h3 class="status-task-title">

                        ${escapeHtml(task.title)}

                    </h3>


                    <p class="status-task-desc">

                        ${escapeHtml(task.description)}

                    </p>


                    <div class="status-task-assignee">

                        <div class="employee-avatar">

                            ${escapeHtml(task.initial)}

                        </div>

                        <span>
                            ${escapeHtml(task.employeeName)}
                        </span>

                    </div>


                    <div class="status-progress-wrap">

                        <div class="status-progress-bar">

                            <div class="status-progress-fill"
                                 style="width:${task.progress}%;">
                            </div>

                        </div>

                        <span class="status-progress-text">

                            ${task.progress}%

                        </span>

                    </div>


                    <div class="status-task-actions">

                        ${
                            isCompleted

                            ? `

                                <span class="status completed">

                                    <i class="bi bi-check-circle-fill"></i>

                                    Completed

                                </span>

                              `

                            : `

                                <form action="/Task/Complete"
                                      method="post"
                                      style="margin:0;">

                                    <input type="hidden"
                                           name="__RequestVerificationToken"
                                           value="${csrf}" />

                                    <input type="hidden"
                                           name="id"
                                           value="${task.id}" />

                                    <button type="submit"
                                            class="status complete-button"
                                            onclick="return confirm('Mark this task as completed?');">

                                        <i class="bi bi-check2"></i>

                                        Mark Completed

                                    </button>

                                </form>

                              `
                        }

                    </div>

                </div>

            `;

        });


        html +=
            "</div>";


        bodyEl.innerHTML =
            html;


        if (paginationEl) {

            paginationEl.style.display =
                totalItems > 0
                    ? "flex"
                    : "none";


            infoEl.textContent =
                `Showing ${startIndex + 1}-${endIndex} of ${totalItems} tasks`;


            prevBtn.disabled =
                modalCurrentPage === 1;


            nextBtn.disabled =
                modalCurrentPage === totalPages;


            let pagesHtml = "";


            for (
                let p = 1;
                p <= totalPages;
                p++
            ) {

                pagesHtml +=
                    `<button type="button"
                             class="page-num ${p === modalCurrentPage ? "active" : ""}"
                             onclick="goToStatusPage(${p})">
                        ${p}
                     </button>`;

            }


            pageNumbersEl.innerHTML =
                pagesHtml;

        }

    }


    function changeStatusPage(delta) {

        modalCurrentPage += delta;

        renderStatusModalPage();


        document
            .getElementById(
                "statusModalBody"
            )
            ?.scrollTo({
                top: 0,
                behavior: "smooth"
            });

    }


    function goToStatusPage(page) {

        modalCurrentPage =
            page;

        renderStatusModalPage();


        document
            .getElementById(
                "statusModalBody"
            )
            ?.scrollTo({
                top: 0,
                behavior: "smooth"
            });

    }


    function closeStatusTasksModal() {

        const modal =
            document.getElementById(
                "statusTasksModal"
            );


        if (modal) {

            modal.classList.remove("show");

        }


        document.body.style.overflow =
            "";

    }


    // =========================================================
    // ESCAPE HTML
    // =========================================================

    function escapeHtml(text) {

        if (!text)
            return "";


        const div =
            document.createElement("div");


        div.textContent =
            text;


        return div.innerHTML;

    }


    // =========================================================
    // ASSIGN TASK MODAL
    // =========================================================

    function openTaskModal() {

        const modal =
            document.getElementById(
                "taskModal"
            );


        if (modal) {

            modal.classList.add("show");

            document.body.style.overflow =
                "hidden";

        }

    }


    function closeTaskModal() {

        const modal =
            document.getElementById(
                "taskModal"
            );


        if (modal) {

            modal.classList.remove("show");

            document.body.style.overflow =
                "";

        }

    }


    // =========================================================
    // ESC KEY
    // =========================================================

    document.addEventListener(
        "keydown",
        function (event) {

            if (event.key === "Escape") {

                closeTaskModal();

                closeStatusTasksModal();

            }

        }
    );


    // =========================================================
    // INITIALIZE
    // =========================================================

    document.addEventListener(
        "DOMContentLoaded",
        function () {

            renderGridPage();

        }
    );

</script>

}