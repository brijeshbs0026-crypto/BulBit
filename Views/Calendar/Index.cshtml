@model List<AuthMvcApp.Models.CalendarEvent>

@{
    ViewData["Title"] = "Calendar";

    var today = DateTime.Today;

    var currentMonth = ViewBag.CurrentMonth != null
        ? (int)ViewBag.CurrentMonth
        : today.Month;

    var currentYear = ViewBag.CurrentYear != null
        ? (int)ViewBag.CurrentYear
        : today.Year;

    var firstDay = new DateTime(currentYear, currentMonth, 1);
    var daysInMonth = DateTime.DaysInMonth(currentYear, currentMonth);

    // Monday = 0
    var startDay = ((int)firstDay.DayOfWeek + 6) % 7;

    var previousMonth = firstDay.AddMonths(-1);
    var nextMonth = firstDay.AddMonths(1);
}

<div class="calendar-page">

    <!-- HEADER -->
    <div class="calendar-header">
        <div>
            <div class="eyebrow">SCHEDULE</div>
            <h1>Calendar</h1>
            <p>Tasks, meetings and important dates.</p>
        </div>

        @if (User.IsInRole("Admin"))
        {
            <button type="button"
                    class="btn primary"
                    onclick="openAddEventModal()">
                + Add Event
            </button>
        }
    </div>

    <!-- SUCCESS / ERROR MESSAGE -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="calendar-alert success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="calendar-alert error">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- CALENDAR -->
    <div class="calendar-card">

        <!-- MONTH HEADER -->
        <div class="calendar-month-header">
            <a class="month-nav"
               asp-controller="Calendar"
               asp-action="Index"
               asp-route-month="@previousMonth.Month"
               asp-route-year="@previousMonth.Year">
                ‹
            </a>

            <h2>
                @firstDay.ToString("MMMM yyyy")
            </h2>

            <a class="month-nav"
               asp-controller="Calendar"
               asp-action="Index"
               asp-route-month="@nextMonth.Month"
               asp-route-year="@nextMonth.Year">
                ›
            </a>
        </div>

        <!-- WEEK DAYS -->
        <div class="calendar-weekdays">
            <div>MON</div>
            <div>TUE</div>
            <div>WED</div>
            <div>THU</div>
            <div>FRI</div>
            <div>SAT</div>
            <div>SUN</div>
        </div>

        <!-- DAYS -->
        <div class="calendar-grid">
            @for (int i = 0; i < startDay; i++)
            {
                <div class="calendar-day empty-day"></div>
            }

            @for (int day = 1; day <= daysInMonth; day++)
            {
                var date = new DateTime(currentYear, currentMonth, day);
                var isToday = date == today;
                var dateString = date.ToString("yyyy-MM-dd");

                var dayEvents = Model
                    .Where(x => x.EventDate.Date == date)
                    .ToList();

                <div class="calendar-day @(isToday ? "today" : "")">

                    <div class="calendar-day-header-row">
                        <span class="calendar-day-number">@day</span>
                        @if (User.IsInRole("Admin"))
                        {
                            <button type="button" class="quick-add-day-btn" title="Add event on this date" onclick="openAddEventModal('@dateString')">＋</button>
                        }
                    </div>

                    <div class="calendar-day-events">
                        @foreach (var eventItem in dayEvents)
                        {
                            var typeClass = (eventItem.EventType ?? "Other").ToLowerInvariant();
                            var desc = eventItem.Description ?? "";

                            <div class="calendar-event @typeClass"
                                 onclick="handleEventClick(@eventItem.Id, '@Html.Raw(Html.Encode(eventItem.Title))', '@Html.Raw(Html.Encode(desc))', '@eventItem.EventDate.ToString("yyyy-MM-dd")', '@(eventItem.EventType ?? "Other")')">
                                
                                <div class="event-main-info">
                                    <span class="event-type-dot"></span>
                                    <strong class="event-title">@eventItem.Title</strong>
                                </div>

                                <div class="event-meta-row">
                                    @if (!string.IsNullOrEmpty(eventItem.EventType))
                                    {
                                        <span class="event-type-pill">@eventItem.EventType</span>
                                    }

                                    @if (User.IsInRole("Admin"))
                                    {
                                        <div class="event-quick-actions" onclick="event.stopPropagation()">
                                            <button type="button" class="event-action-btn edit-btn" title="Edit Event"
                                                    onclick="openEditEventModal(@eventItem.Id, '@Html.Raw(Html.Encode(eventItem.Title))', '@Html.Raw(Html.Encode(desc))', '@eventItem.EventDate.ToString("yyyy-MM-dd")', '@(eventItem.EventType ?? "Other")')">
                                                ✏️
                                            </button>
                                            
                                            <form asp-controller="Calendar"
                                                  asp-action="Delete"
                                                  asp-route-id="@eventItem.Id"
                                                  asp-route-month="@currentMonth"
                                                  asp-route-year="@currentYear"
                                                  method="post"
                                                  style="display:inline;"
                                                  onsubmit="return confirm('Are you sure you want to delete this event?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="event-action-btn delete-btn" title="Delete Event">
                                                    🗑️
                                                </button>
                                            </form>
                                        </div>
                                    }
                                </div>

                            </div>
                        }
                    </div>

                </div>
            }
        </div>

    </div>

</div>

<!-- ================= ADD EVENT MODAL (ADMIN) ================= -->
@if (User.IsInRole("Admin"))
{
    <div id="addEventModal" class="calendar-modal">
        <div class="calendar-modal-overlay" onclick="closeAddEventModal()"></div>

        <div class="calendar-modal-content">
            <button type="button" class="calendar-modal-close" onclick="closeAddEventModal()">×</button>

            <h2>Add Event</h2>
            <p>Create a new calendar event for the workspace.</p>

            <form asp-controller="Calendar" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="month" value="@currentMonth" />
                <input type="hidden" name="year" value="@currentYear" />

                <div class="calendar-form-group">
                    <label>Event Title</label>
                    <input type="text" name="Title" class="calendar-input" placeholder="e.g. Q3 Strategy Meeting" required />
                </div>

                <div class="calendar-form-group">
                    <label>Description (Optional)</label>
                    <textarea name="Description" class="calendar-input calendar-textarea" placeholder="Describe the agenda, location, or notes..."></textarea>
                </div>

                <div class="calendar-form-row">
                    <div class="calendar-form-group">
                        <label>Date</label>
                        <input type="date" id="addEventDate" name="EventDate" class="calendar-input" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>

                    <div class="calendar-form-group">
                        <label>Event Type</label>
                        <select name="EventType" class="calendar-input">
                            <option value="Meeting">Meeting</option>
                            <option value="Task">Task</option>
                            <option value="Holiday">Holiday</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                </div>

                <button type="submit" class="calendar-save-btn">
                    + Create Event
                </button>
            </form>
        </div>
    </div>

    <!-- ================= EDIT EVENT MODAL (ADMIN) ================= -->
    <div id="editEventModal" class="calendar-modal">
        <div class="calendar-modal-overlay" onclick="closeEditEventModal()"></div>

        <div class="calendar-modal-content">
            <button type="button" class="calendar-modal-close" onclick="closeEditEventModal()">×</button>

            <h2>Edit Event</h2>
            <p>Modify event details or remove it from the schedule.</p>

            <form asp-controller="Calendar" asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editEventId" name="Id" />
                <input type="hidden" name="month" value="@currentMonth" />
                <input type="hidden" name="year" value="@currentYear" />

                <div class="calendar-form-group">
                    <label>Event Title</label>
                    <input type="text" id="editEventTitle" name="Title" class="calendar-input" required />
                </div>

                <div class="calendar-form-group">
                    <label>Description</label>
                    <textarea id="editEventDescription" name="Description" class="calendar-input calendar-textarea" placeholder="Event notes or details..."></textarea>
                </div>

                <div class="calendar-form-row">
                    <div class="calendar-form-group">
                        <label>Date</label>
                        <input type="date" id="editEventDate" name="EventDate" class="calendar-input" required />
                    </div>

                    <div class="calendar-form-group">
                        <label>Event Type</label>
                        <select id="editEventType" name="EventType" class="calendar-input">
                            <option value="Meeting">Meeting</option>
                            <option value="Task">Task</option>
                            <option value="Holiday">Holiday</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                </div>

                <div class="calendar-modal-btn-row">
                    <button type="submit" class="calendar-save-btn">
                        Save Changes
                    </button>
                    
                    <button type="button" class="calendar-delete-btn" onclick="submitEditModalDelete()">
                        🗑️ Delete Event
                    </button>
                </div>
            </form>

            <!-- Hidden delete form triggered by the edit modal delete button -->
            <form id="editModalDeleteForm" asp-controller="Calendar" asp-action="Delete" method="post" style="display:none;">
                @Html.AntiForgeryToken()
                <input type="hidden" id="deleteFormEventId" name="id" />
                <input type="hidden" name="month" value="@currentMonth" />
                <input type="hidden" name="year" value="@currentYear" />
            </form>
        </div>
    </div>
}
else
{
    <!-- ================= VIEW EVENT DETAILS MODAL (EMPLOYEE) ================= -->
    <div id="viewEventModal" class="calendar-modal">
        <div class="calendar-modal-overlay" onclick="closeViewEventModal()"></div>

        <div class="calendar-modal-content">
            <button type="button" class="calendar-modal-close" onclick="closeViewEventModal()">×</button>

            <span class="event-detail-type-pill" id="viewEventTypePill">Meeting</span>
            <h2 id="viewEventTitle" style="margin-top: 10px;">Event Details</h2>
            <div class="event-detail-date" id="viewEventDate">Date</div>

            <div class="calendar-form-group" style="margin-top: 18px;">
                <label>Description</label>
                <div class="event-detail-desc" id="viewEventDescription">No description provided.</div>
            </div>

            <button type="button" class="calendar-save-btn" onclick="closeViewEventModal()" style="margin-top: 20px;">
                Close
            </button>
        </div>
    </div>
}

@section Scripts
{
    <script>
        const isAdmin = @(User.IsInRole("Admin") ? "true" : "false");

        function handleEventClick(id, title, desc, date, type) {
            if (isAdmin) {
                openEditEventModal(id, title, desc, date, type);
            } else {
                openViewEventModal(id, title, desc, date, type);
            }
        }

        // Add Modal
        function openAddEventModal(defaultDate) {
            if (defaultDate) {
                const dateInput = document.getElementById("addEventDate");
                if (dateInput) dateInput.value = defaultDate;
            }
            const modal = document.getElementById("addEventModal");
            if (modal) {
                modal.classList.add("show");
                document.body.style.overflow = "hidden";
            }
        }

        function closeAddEventModal() {
            const modal = document.getElementById("addEventModal");
            if (modal) {
                modal.classList.remove("show");
                document.body.style.overflow = "";
            }
        }

        // Edit Modal (Admin)
        function openEditEventModal(id, title, desc, date, type) {
            const modal = document.getElementById("editEventModal");
            if (!modal) return;

            document.getElementById("editEventId").value = id;
            document.getElementById("editEventTitle").value = title;
            document.getElementById("editEventDescription").value = desc;
            document.getElementById("editEventDate").value = date;
            document.getElementById("editEventType").value = type;

            modal.classList.add("show");
            document.body.style.overflow = "hidden";
        }

        function closeEditEventModal() {
            const modal = document.getElementById("editEventModal");
            if (modal) {
                modal.classList.remove("show");
                document.body.style.overflow = "";
            }
        }

        function submitEditModalDelete() {
            const id = document.getElementById("editEventId").value;
            if (!id) return;

            if (confirm("Are you sure you want to delete this event?")) {
                document.getElementById("deleteFormEventId").value = id;
                document.getElementById("editModalDeleteForm").submit();
            }
        }

        // View Modal (Employee)
        function openViewEventModal(id, title, desc, date, type) {
            const modal = document.getElementById("viewEventModal");
            if (!modal) return;

            document.getElementById("viewEventTitle").textContent = title;
            document.getElementById("viewEventDate").textContent = "📅 " + date;
            document.getElementById("viewEventDescription").textContent = desc || "No description provided.";
            
            const pill = document.getElementById("viewEventTypePill");
            if (pill) {
                pill.textContent = type;
                pill.className = "event-detail-type-pill " + type.toLowerCase();
            }

            modal.classList.add("show");
            document.body.style.overflow = "hidden";
        }

        function closeViewEventModal() {
            const modal = document.getElementById("viewEventModal");
            if (modal) {
                modal.classList.remove("show");
                document.body.style.overflow = "";
            }
        }

        // Close popups using ESC
        document.addEventListener("keydown", function (event) {
            if (event.key === "Escape") {
                closeAddEventModal();
                closeEditEventModal();
                closeViewEventModal();
            }
        });
    </script>
}