@model List<AuthMvcApp.Models.CalendarEvent>

@{
    ViewData["Title"] = "Calendar";

    var today = DateTime.Today;

    var currentMonth = ViewBag.CurrentMonth != null
        ? (int)ViewBag.CurrentMonth
        : today.Month;

    var currentYear = ViewBag.CurrentYear != null
        ? (int)ViewBag.CurrentYear
        : today.Year;

    var firstDay = new DateTime(currentYear, currentMonth, 1);

    var daysInMonth =
        DateTime.DaysInMonth(currentYear, currentMonth);

    // Monday = 0
    var startDay =
        ((int)firstDay.DayOfWeek + 6) % 7;

    var previousMonth =
        firstDay.AddMonths(-1);

    var nextMonth =
        firstDay.AddMonths(1);
}


<style>

    /* =========================================================
       CALENDAR PAGE
       ========================================================= */

    .calendar-page {
        max-width: 1500px;

        margin: 0 auto;

        padding: 32px 38px 55px;

        color: #182238;
    }


    /* =========================================================
       HEADER
       ========================================================= */

    .calendar-header {
        display: flex;

        align-items: center;

        justify-content: space-between;

        gap: 20px;

        margin-bottom: 25px;
    }


    .calendar-header h1 {
        margin: 4px 0 4px;

        color: #152039;

        font-size: 35px;

        line-height: 1.1;

        font-weight: 800;

        letter-spacing: -1px;
    }


    .calendar-header p {
        margin: 0;

        color: #8994a8;

        font-size: 13px;
    }


    .eyebrow {
        color: #6850eb;

        font-size: 10px;

        font-weight: 800;

        letter-spacing: 1.4px;
    }


    /* =========================================================
       BUTTONS
       ========================================================= */

    .btn.primary {
        display: inline-flex;

        align-items: center;

        justify-content: center;

        gap: 7px;

        min-height: 42px;

        padding: 0 17px;

        border: none;

        border-radius: 10px;

        background: linear-gradient(
            135deg,
            #7659f5,
            #6544e8
        );

        color: #ffffff;

        font-size: 12px;

        font-weight: 750;

        cursor: pointer;

        box-shadow:
            0 8px 20px rgba(103, 75, 235, 0.22);

        transition: all 0.2s ease;
    }


    .btn.primary:hover {
        transform: translateY(-2px);

        box-shadow:
            0 12px 26px rgba(103, 75, 235, 0.30);
    }


    /* =========================================================
       ALERTS
       ========================================================= */

    .calendar-alert {
        display: flex;

        align-items: center;

        gap: 8px;

        margin-bottom: 18px;

        padding: 12px 15px;

        border-radius: 10px;

        font-size: 12px;

        font-weight: 650;
    }


    .calendar-alert.success {
        background: #eafaf4;

        border: 1px solid #c8f0e1;

        color: #168566;
    }


    .calendar-alert.error {
        background: #fff0f2;

        border: 1px solid #ffd6dc;

        color: #d84c5b;
    }


    /* =========================================================
       CALENDAR CARD
       ========================================================= */

    .calendar-card {
        padding: 22px 24px 25px;

        background: #ffffff;

        border: 1px solid #e5e9f0;

        border-radius: 18px;

        box-shadow:
            0 8px 28px rgba(25, 37, 65, 0.055);
    }


    /* =========================================================
       MONTH HEADER
       ========================================================= */

    .calendar-month-header {
        display: flex;

        align-items: center;

        justify-content: center;

        gap: 18px;

        margin-bottom: 24px;
    }


    .calendar-month-header h2 {
        min-width: 190px;

        margin: 0;

        text-align: center;

        color: #172036;

        font-size: 20px;

        font-weight: 800;

        letter-spacing: -0.3px;
    }


    .month-nav {
        width: 34px;

        height: 34px;

        display: flex;

        align-items: center;

        justify-content: center;

        border: 1px solid #e1e5ed;

        border-radius: 9px;

        background: #ffffff;

        color: #526078;

        font-size: 21px;

        line-height: 1;

        text-decoration: none;

        transition: all 0.2s ease;
    }


    .month-nav:hover {
        border-color: #d3ccff;

        background: #f4f1ff;

        color: #6548df;

        transform: translateY(-1px);
    }


    /* =========================================================
       WEEK DAYS
       ========================================================= */

    .calendar-weekdays {
        display: grid;

        grid-template-columns:
            repeat(7, minmax(0, 1fr));

        gap: 7px;

        margin-bottom: 7px;
    }


    .calendar-weekdays div {
        padding: 8px 5px;

        text-align: center;

        color: #8a95a8;

        font-size: 10px;

        font-weight: 800;

        letter-spacing: 0.8px;
    }


    /* =========================================================
       CALENDAR GRID
       ========================================================= */

    .calendar-grid {
        display: grid;

        grid-template-columns:
            repeat(7, minmax(0, 1fr));

        gap: 7px;
    }


    /* =========================================================
       DAY
       ========================================================= */

    .calendar-day {
        position: relative;

        min-height: 115px;

        box-sizing: border-box;

        padding: 9px;

        background: #ffffff;

        border: 1px solid #e3e8f0;

        border-radius: 11px;

        transition:
            border-color 0.2s ease,
            box-shadow 0.2s ease,
            transform 0.2s ease;
    }


    .calendar-day:hover {
        border-color: #d6d0ff;

        box-shadow:
            0 7px 18px rgba(35, 45, 75, 0.065);
    }


    .calendar-day.empty-day {
        min-height: 115px;

        border-color: transparent;

        background: #fafbfc;

        box-shadow: none;
    }


    /* =========================================================
       TODAY
       ========================================================= */

    .calendar-day.today {
        border: 2px solid #7659f5;

        background:
            linear-gradient(
                180deg,
                #f8f6ff 0%,
                #ffffff 42%
            );

        box-shadow:
            0 7px 20px rgba(103, 75, 235, 0.10);
    }


    .calendar-day.today .calendar-day-number {
        min-width: 27px;

        height: 27px;

        display: inline-flex;

        align-items: center;

        justify-content: center;

        border-radius: 8px;

        background: #7659f5;

        color: #ffffff;
    }


    /* =========================================================
       DAY HEADER
       ========================================================= */

    .calendar-day-header-row {
        display: flex;

        align-items: center;

        justify-content: space-between;

        gap: 5px;

        margin-bottom: 7px;
    }


    .calendar-day-number {
        display: inline-flex;

        align-items: center;

        justify-content: center;

        min-width: 27px;

        height: 27px;

        color: #28334a;

        font-size: 11px;

        font-weight: 800;
    }


    /* =========================================================
       QUICK ADD
       ========================================================= */

    .quick-add-day-btn {
        width: 25px;

        height: 25px;

        display: flex;

        align-items: center;

        justify-content: center;

        border: 1px solid transparent;

        border-radius: 7px;

        background: transparent;

        color: #a0a9b8;

        font-size: 17px;

        line-height: 1;

        cursor: pointer;

        opacity: 0;

        transition: all 0.2s ease;
    }


    .calendar-day:hover .quick-add-day-btn,
    .calendar-day.today .quick-add-day-btn {
        opacity: 1;
    }


    .quick-add-day-btn:hover {
        border-color: #dcd6ff;

        background: #f2efff;

        color: #684be8;
    }


    /* =========================================================
       EVENTS
       ========================================================= */

    .calendar-day-events {
        display: flex;

        flex-direction: column;

        gap: 5px;
    }


    .calendar-event {
        position: relative;

        padding: 7px 8px;

        border: 1px solid transparent;

        border-radius: 8px;

        cursor: pointer;

        overflow: hidden;

        transition:
            transform 0.18s ease,
            box-shadow 0.18s ease;
    }


    .calendar-event:hover {
        transform: translateY(-1px);

        box-shadow:
            0 5px 12px rgba(30, 40, 70, 0.08);
    }


    /* =========================================================
       EVENT COLORS
       ========================================================= */

    .calendar-event.meeting {
        background: #edf1ff;

        border-color: #d5dcff;

        color: #5140bd;
    }


    .calendar-event.task {
        background: #eafaf4;

        border-color: #ccefe2;

        color: #167e61;
    }


    .calendar-event.holiday {
        background: #fff3e5;

        border-color: #ffe0b8;

        color: #c4771c;
    }


    .calendar-event.other {
        background: #f2efff;

        border-color: #dfd8ff;

        color: #6548df;
    }


    /* =========================================================
       EVENT MAIN INFO
       ========================================================= */

    .event-main-info {
        display: flex;

        align-items: center;

        gap: 6px;

        min-width: 0;
    }


    .event-type-dot {
        width: 6px;

        height: 6px;

        flex-shrink: 0;

        border-radius: 50%;

        background: currentColor;
    }


    .event-title {
        display: block;

        max-width: 100%;

        overflow: hidden;

        text-overflow: ellipsis;

        white-space: nowrap;

        font-size: 10px;

        font-weight: 750;
    }


    .event-meta-row {
        display: flex;

        align-items: center;

        justify-content: space-between;

        gap: 5px;

        margin-top: 4px;
    }


    .event-type-pill {
        max-width: 75px;

        overflow: hidden;

        text-overflow: ellipsis;

        white-space: nowrap;

        font-size: 8px;

        font-weight: 750;

        text-transform: uppercase;

        opacity: 0.72;
    }


    /* =========================================================
       EVENT ACTIONS
       ========================================================= */

    .event-quick-actions {
        display: flex;

        align-items: center;

        gap: 2px;
    }


    .event-action-btn {
        width: 22px;

        height: 22px;

        display: flex;

        align-items: center;

        justify-content: center;

        border: none;

        border-radius: 5px;

        background: rgba(255, 255, 255, 0.72);

        font-size: 10px;

        cursor: pointer;

        transition: all 0.18s ease;
    }


    .event-action-btn.edit-btn {
        color: #5f49d6;
    }


    .event-action-btn.delete-btn {
        color: #d64c5b;
    }


    .event-action-btn:hover {
        background: #ffffff;

        transform: scale(1.08);
    }


    /* =========================================================
       MODAL
       ========================================================= */

    .calendar-modal {
        position: fixed;

        inset: 0;

        z-index: 9999;

        display: none;

        align-items: center;

        justify-content: center;
    }


    .calendar-modal.show {
        display: flex;
    }


    .calendar-modal-overlay {
        position: absolute;

        inset: 0;

        background: rgba(15, 23, 42, 0.50);

        backdrop-filter: blur(5px);
    }


    .calendar-modal-content {
        position: relative;

        z-index: 2;

        width: min(580px, calc(100% - 30px));

        max-height: 90vh;

        overflow-y: auto;

        box-sizing: border-box;

        padding: 29px;

        background: #ffffff;

        border: 1px solid #e4e8ef;

        border-radius: 20px;

        box-shadow:
            0 30px 80px rgba(15, 23, 42, 0.23);

        animation: calendarModalIn 0.2s ease;
    }


    @@keyframes calendarModalIn {

        from {
            opacity: 0;

            transform:
                translateY(12px)
                scale(0.98);
        }

        to {
            opacity: 1;

            transform:
                translateY(0)
                scale(1);
        }

    }


    /* =========================================================
       MODAL CLOSE
       ========================================================= */

    .calendar-modal-close {
        position: absolute;

        top: 17px;

        right: 17px;

        width: 34px;

        height: 34px;

        display: flex;

        align-items: center;

        justify-content: center;

        border: 1px solid #e2e6ed;

        border-radius: 9px;

        background: #ffffff;

        color: #7e899d;

        font-size: 21px;

        line-height: 1;

        cursor: pointer;

        transition: all 0.2s ease;
    }


    .calendar-modal-close:hover {
        background: #fff0f2;

        border-color: #ffd4da;

        color: #dc4e5b;
    }


    .calendar-modal-content h2 {
        margin: 0 35px 7px 0;

        color: #172036;

        font-size: 23px;

        font-weight: 800;
    }


    .calendar-modal-content > p {
        margin: 0 0 23px;

        color: #8a95a8;

        font-size: 12px;
    }


    /* =========================================================
       FORM
       ========================================================= */

    .calendar-form-group {
        margin-bottom: 17px;
    }


    .calendar-form-group label {
        display: block;

        margin-bottom: 7px;

        color: #39445a;

        font-size: 11px;

        font-weight: 750;
    }


    .calendar-input {
        width: 100%;

        box-sizing: border-box;

        min-height: 43px;

        padding: 10px 12px;

        border: 1px solid #dfe4ec;

        border-radius: 10px;

        outline: none;

        background: #fafbfe;

        color: #28334a;

        font-family: inherit;

        font-size: 12px;

        transition: all 0.2s ease;
    }


    .calendar-input:focus {
        border-color: #7659f5;

        background: #ffffff;

        box-shadow:
            0 0 0 4px rgba(118, 89, 245, 0.08);
    }


    .calendar-textarea {
        min-height: 105px;

        resize: vertical;
    }


    .calendar-form-row {
        display: grid;

        grid-template-columns:
            repeat(2, minmax(0, 1fr));

        gap: 15px;
    }


    /* =========================================================
       SAVE BUTTON
       ========================================================= */

    .calendar-save-btn {
        width: 100%;

        min-height: 45px;

        border: none;

        border-radius: 10px;

        background: linear-gradient(
            135deg,
            #7659f5,
            #6544e8
        );

        color: #ffffff;

        font-size: 12px;

        font-weight: 750;

        cursor: pointer;

        box-shadow:
            0 8px 20px rgba(103, 75, 235, 0.20);

        transition: all 0.2s ease;
    }


    .calendar-save-btn:hover {
        transform: translateY(-1px);

        box-shadow:
            0 12px 25px rgba(103, 75, 235, 0.27);
    }


    /* =========================================================
       EDIT MODAL BUTTONS
       ========================================================= */

    .calendar-modal-btn-row {
        display: grid;

        grid-template-columns:
            1fr 1fr;

        gap: 10px;

        margin-top: 5px;
    }


    .calendar-modal-btn-row .calendar-save-btn {
        margin: 0;
    }


    .calendar-delete-btn {
        min-height: 45px;

        border: 1px solid #ffd7dc;

        border-radius: 10px;

        background: #fff1f3;

        color: #d64d5a;

        font-size: 12px;

        font-weight: 750;

        cursor: pointer;

        transition: all 0.2s ease;
    }


    .calendar-delete-btn:hover {
        background: #ffe5e9;

        border-color: #ffc5cd;
    }


    /* =========================================================
       VIEW EVENT
       ========================================================= */

    .event-detail-type-pill {
        display: inline-flex;

        align-items: center;

        padding: 6px 10px;

        border-radius: 8px;

        background: #eeeaff;

        color: #6548df;

        font-size: 10px;

        font-weight: 800;

        text-transform: uppercase;
    }


    .event-detail-type-pill.meeting {
        background: #edf1ff;

        color: #5140bd;
    }


    .event-detail-type-pill.task {
        background: #eafaf4;

        color: #167e61;
    }


    .event-detail-type-pill.holiday {
        background: #fff3e5;

        color: #c4771c;
    }


    .event-detail-type-pill.other {
        background: #eeeaff;

        color: #6548df;
    }


    .event-detail-date {
        margin-top: 8px;

        color: #8a95a8;

        font-size: 12px;

        font-weight: 650;
    }


    .event-detail-desc {
        min-height: 80px;

        box-sizing: border-box;

        padding: 12px;

        border: 1px solid #e2e6ed;

        border-radius: 10px;

        background: #fafbfe;

        color: #59657a;

        font-size: 12px;

        line-height: 1.6;
    }


    /* =========================================================
       RESPONSIVE - TABLET
       ========================================================= */

    @@media (max-width: 1100px) {

        .calendar-page {
            padding: 28px 22px 45px;
        }

        .calendar-card {
            padding: 18px;
        }

        .calendar-day {
            min-height: 105px;
        }

        .calendar-day.empty-day {
            min-height: 105px;
        }

        .event-quick-actions {
            display: none;
        }

    }


    /* =========================================================
       RESPONSIVE - SMALL TABLET
       ========================================================= */

    @@media (max-width: 800px) {

        .calendar-header {
            align-items: flex-start;

            flex-direction: column;
        }

        .calendar-header .btn.primary {
            width: 100%;
        }

        .calendar-card {
            overflow-x: auto;
        }

        .calendar-weekdays,
        .calendar-grid {
            min-width: 720px;
        }

    }


    /* =========================================================
       RESPONSIVE - MOBILE
       ========================================================= */

    @@media (max-width: 600px) {

        .calendar-page {
            padding: 22px 14px 40px;
        }

        .calendar-header h1 {
            font-size: 30px;
        }

        .calendar-card {
            padding: 15px;
        }

        .calendar-month-header {
            gap: 10px;
        }

        .calendar-month-header h2 {
            min-width: 150px;

            font-size: 17px;
        }

        .calendar-form-row {
            grid-template-columns: 1fr;
        }

        .calendar-modal-content {
            padding: 23px 18px;
        }

        .calendar-modal-btn-row {
            grid-template-columns: 1fr;
        }

    }

</style>


<div class="calendar-page">


    <!-- =====================================================
         HEADER
         ===================================================== -->

    <div class="calendar-header">

        <div>

            <div class="eyebrow">
                SCHEDULE
            </div>

            <h1>
                Calendar
            </h1>

            <p>
                Tasks, meetings and important dates.
            </p>

        </div>


        @if (User.IsInRole("Admin"))
        {

            <button type="button"
                    class="btn primary"
                    onclick="openAddEventModal()">

                <span>
                    ＋
                </span>

                Add Event

            </button>

        }

    </div>


    <!-- =====================================================
         ALERTS
         ===================================================== -->

    @if (TempData["SuccessMessage"] != null)
    {

        <div class="calendar-alert success">

            <span>
                ✓
            </span>

            @TempData["SuccessMessage"]

        </div>

    }


    @if (TempData["ErrorMessage"] != null)
    {

        <div class="calendar-alert error">

            <span>
                !
            </span>

            @TempData["ErrorMessage"]

        </div>

    }


    <!-- =====================================================
         CALENDAR
         ===================================================== -->

    <div class="calendar-card">


        <!-- MONTH HEADER -->

        <div class="calendar-month-header">

            <a class="month-nav"
               asp-controller="Calendar"
               asp-action="Index"
               asp-route-month="@previousMonth.Month"
               asp-route-year="@previousMonth.Year"
               title="Previous month">

                ‹

            </a>


            <h2>
                @firstDay.ToString("MMMM yyyy")
            </h2>


            <a class="month-nav"
               asp-controller="Calendar"
               asp-action="Index"
               asp-route-month="@nextMonth.Month"
               asp-route-year="@nextMonth.Year"
               title="Next month">

                ›

            </a>

        </div>


        <!-- WEEK DAYS -->

        <div class="calendar-weekdays">

            <div>
                MON
            </div>

            <div>
                TUE
            </div>

            <div>
                WED
            </div>

            <div>
                THU
            </div>

            <div>
                FRI
            </div>

            <div>
                SAT
            </div>

            <div>
                SUN
            </div>

        </div>


        <!-- DAYS -->

        <div class="calendar-grid">


            @for (int i = 0; i < startDay; i++)
            {

                <div class="calendar-day empty-day">
                </div>

            }


            @for (
                int day = 1;
                day <= daysInMonth;
                day++
            )
            {

                var date =
                    new DateTime(
                        currentYear,
                        currentMonth,
                        day
                    );


                var isToday =
                    date == today;


                var dateString =
                    date.ToString("yyyy-MM-dd");


                var dayEvents =
                    Model
                        .Where(x =>
                            x.EventDate.Date == date)
                        .ToList();


                <div class="calendar-day @(isToday ? "today" : "")">


                    <!-- DAY HEADER -->

                    <div class="calendar-day-header-row">


                        <span class="calendar-day-number">
                            @day
                        </span>


                        @if (User.IsInRole("Admin"))
                        {

                            <button type="button"
                                    class="quick-add-day-btn"
                                    title="Add event on this date"
                                    onclick="openAddEventModal('@dateString')">

                                ＋

                            </button>

                        }

                    </div>


                    <!-- EVENTS -->

                    <div class="calendar-day-events">


                        @foreach (var eventItem in dayEvents)
                        {

                            var typeClass =
                                (
                                    eventItem.EventType
                                    ?? "Other"
                                )
                                .ToLowerInvariant();


                            var desc =
                                eventItem.Description
                                ?? "";


                            <div class="calendar-event @typeClass"
                                 onclick="handleEventClick(@eventItem.Id, '@Html.Raw(Html.Encode(eventItem.Title))', '@Html.Raw(Html.Encode(desc))', '@eventItem.EventDate.ToString("yyyy-MM-dd")', '@(eventItem.EventType ?? "Other")')">


                                <div class="event-main-info">

                                    <span class="event-type-dot">
                                    </span>

                                    <strong class="event-title">
                                        @eventItem.Title
                                    </strong>

                                </div>


                                <div class="event-meta-row">


                                    @if (!string.IsNullOrEmpty(
                                        eventItem.EventType))
                                    {

                                        <span class="event-type-pill">

                                            @eventItem.EventType

                                        </span>

                                    }


                                    @if (User.IsInRole("Admin"))
                                    {

                                        <div class="event-quick-actions"
                                             onclick="event.stopPropagation()">


                                            <!-- EDIT -->

                                            <button type="button"
                                                    class="event-action-btn edit-btn"
                                                    title="Edit Event"
                                                    onclick="openEditEventModal(@eventItem.Id, '@Html.Raw(Html.Encode(eventItem.Title))', '@Html.Raw(Html.Encode(desc))', '@eventItem.EventDate.ToString("yyyy-MM-dd")', '@(eventItem.EventType ?? "Other")')">

                                                ✏

                                            </button>


                                            <!-- DELETE -->

                                            <form asp-controller="Calendar"
                                                  asp-action="Delete"
                                                  asp-route-id="@eventItem.Id"
                                                  asp-route-month="@currentMonth"
                                                  asp-route-year="@currentYear"
                                                  method="post"
                                                  style="display:inline;"
                                                  onsubmit="return confirm('Are you sure you want to delete this event?');">


                                                @Html.AntiForgeryToken()


                                                <button type="submit"
                                                        class="event-action-btn delete-btn"
                                                        title="Delete Event">

                                                    🗑

                                                </button>


                                            </form>

                                        </div>

                                    }

                                </div>

                            </div>

                        }

                    </div>

                </div>

            }

        </div>

    </div>

</div>


<!-- =========================================================
     ADMIN MODALS
     ========================================================= -->

@if (User.IsInRole("Admin"))
{

    <!-- =====================================================
         ADD EVENT MODAL
         ===================================================== -->

    <div id="addEventModal"
         class="calendar-modal">


        <div class="calendar-modal-overlay"
             onclick="closeAddEventModal()">
        </div>


        <div class="calendar-modal-content">


            <button type="button"
                    class="calendar-modal-close"
                    onclick="closeAddEventModal()">

                ×

            </button>


            <h2>
                Add Event
            </h2>


            <p>
                Create a new calendar event for the workspace.
            </p>


            <form asp-controller="Calendar"
                  asp-action="Create"
                  method="post">


                @Html.AntiForgeryToken()


                <input type="hidden"
                       name="month"
                       value="@currentMonth" />


                <input type="hidden"
                       name="year"
                       value="@currentYear" />


                <div class="calendar-form-group">

                    <label>
                        Event Title
                    </label>

                    <input type="text"
                           name="Title"
                           class="calendar-input"
                           placeholder="e.g. Q3 Strategy Meeting"
                           required />

                </div>


                <div class="calendar-form-group">

                    <label>
                        Description
                        (Optional)
                    </label>

                    <textarea name="Description"
                              class="calendar-input calendar-textarea"
                              placeholder="Describe the agenda, location, or notes..."></textarea>

                </div>


                <div class="calendar-form-row">


                    <div class="calendar-form-group">

                        <label>
                            Date
                        </label>

                        <input type="date"
                               id="addEventDate"
                               name="EventDate"
                               class="calendar-input"
                               value="@DateTime.Today.ToString("yyyy-MM-dd")"
                               required />

                    </div>


                    <div class="calendar-form-group">

                        <label>
                            Event Type
                        </label>

                        <select name="EventType"
                                class="calendar-input">

                            <option value="Meeting">
                                Meeting
                            </option>

                            <option value="Task">
                                Task
                            </option>

                            <option value="Holiday">
                                Holiday
                            </option>

                            <option value="Other">
                                Other
                            </option>

                        </select>

                    </div>

                </div>


                <button type="submit"
                        class="calendar-save-btn">

                    ＋ Create Event

                </button>

            </form>

        </div>

    </div>


    <!-- =====================================================
         EDIT EVENT MODAL
         ===================================================== -->

    <div id="editEventModal"
         class="calendar-modal">


        <div class="calendar-modal-overlay"
             onclick="closeEditEventModal()">
        </div>


        <div class="calendar-modal-content">


            <button type="button"
                    class="calendar-modal-close"
                    onclick="closeEditEventModal()">

                ×

            </button>


            <h2>
                Edit Event
            </h2>


            <p>
                Modify event details or remove it from the schedule.
            </p>


            <form asp-controller="Calendar"
                  asp-action="Edit"
                  method="post">


                @Html.AntiForgeryToken()


                <input type="hidden"
                       id="editEventId"
                       name="Id" />


                <input type="hidden"
                       name="month"
                       value="@currentMonth" />


                <input type="hidden"
                       name="year"
                       value="@currentYear" />


                <div class="calendar-form-group">

                    <label>
                        Event Title
                    </label>

                    <input type="text"
                           id="editEventTitle"
                           name="Title"
                           class="calendar-input"
                           required />

                </div>


                <div class="calendar-form-group">

                    <label>
                        Description
                    </label>

                    <textarea id="editEventDescription"
                              name="Description"
                              class="calendar-input calendar-textarea"
                              placeholder="Event notes or details..."></textarea>

                </div>


                <div class="calendar-form-row">


                    <div class="calendar-form-group">

                        <label>
                            Date
                        </label>

                        <input type="date"
                               id="editEventDate"
                               name="EventDate"
                               class="calendar-input"
                               required />

                    </div>


                    <div class="calendar-form-group">

                        <label>
                            Event Type
                        </label>

                        <select id="editEventType"
                                name="EventType"
                                class="calendar-input">

                            <option value="Meeting">
                                Meeting
                            </option>

                            <option value="Task">
                                Task
                            </option>

                            <option value="Holiday">
                                Holiday
                            </option>

                            <option value="Other">
                                Other
                            </option>

                        </select>

                    </div>

                </div>


                <div class="calendar-modal-btn-row">


                    <button type="submit"
                            class="calendar-save-btn">

                        Save Changes

                    </button>


                    <button type="button"
                            class="calendar-delete-btn"
                            onclick="submitEditModalDelete()">

                        🗑 Delete Event

                    </button>

                </div>

            </form>


            <!-- HIDDEN DELETE FORM -->

            <form id="editModalDeleteForm"
                  asp-controller="Calendar"
                  asp-action="Delete"
                  method="post"
                  style="display:none;">


                @Html.AntiForgeryToken()


                <input type="hidden"
                       id="deleteFormEventId"
                       name="id" />


                <input type="hidden"
                       name="month"
                       value="@currentMonth" />


                <input type="hidden"
                       name="year"
                       value="@currentYear" />

            </form>

        </div>

    </div>

}
else
{

    <!-- =====================================================
         EMPLOYEE VIEW EVENT MODAL
         ===================================================== -->

    <div id="viewEventModal"
         class="calendar-modal">


        <div class="calendar-modal-overlay"
             onclick="closeViewEventModal()">
        </div>


        <div class="calendar-modal-content">


            <button type="button"
                    class="calendar-modal-close"
                    onclick="closeViewEventModal()">

                ×

            </button>


            <span class="event-detail-type-pill"
                  id="viewEventTypePill">

                Meeting

            </span>


            <h2 id="viewEventTitle"
                style="margin-top:10px;">

                Event Details

            </h2>


            <div class="event-detail-date"
                 id="viewEventDate">

                Date

            </div>


            <div class="calendar-form-group"
                 style="margin-top:18px;">

                <label>
                    Description
                </label>


                <div class="event-detail-desc"
                     id="viewEventDescription">

                    No description provided.

                </div>

            </div>


            <button type="button"
                    class="calendar-save-btn"
                    onclick="closeViewEventModal()"
                    style="margin-top:20px;">

                Close

            </button>

        </div>

    </div>

}


@section Scripts
{

<script>

    /* =========================================================
       ADMIN CHECK
       ========================================================= */

    const isAdmin =
        @(User.IsInRole("Admin") ? "true" : "false");


    /* =========================================================
       EVENT CLICK
       ========================================================= */

    function handleEventClick(
        id,
        title,
        desc,
        date,
        type
    ) {

        if (isAdmin) {

            openEditEventModal(
                id,
                title,
                desc,
                date,
                type
            );

        }
        else {

            openViewEventModal(
                id,
                title,
                desc,
                date,
                type
            );

        }

    }


    /* =========================================================
       ADD MODAL
       ========================================================= */

    function openAddEventModal(defaultDate) {

        if (defaultDate) {

            const dateInput =
                document.getElementById(
                    "addEventDate"
                );


            if (dateInput) {

                dateInput.value =
                    defaultDate;

            }

        }


        const modal =
            document.getElementById(
                "addEventModal"
            );


        if (modal) {

            modal.classList.add("show");

            document.body.style.overflow =
                "hidden";

        }

    }


    function closeAddEventModal() {

        const modal =
            document.getElementById(
                "addEventModal"
            );


        if (modal) {

            modal.classList.remove("show");

            document.body.style.overflow =
                "";

        }

    }


    /* =========================================================
       EDIT MODAL
       ========================================================= */

    function openEditEventModal(
        id,
        title,
        desc,
        date,
        type
    ) {

        const modal =
            document.getElementById(
                "editEventModal"
            );


        if (!modal)
            return;


        document.getElementById(
            "editEventId"
        ).value = id;


        document.getElementById(
            "editEventTitle"
        ).value = title;


        document.getElementById(
            "editEventDescription"
        ).value = desc;


        document.getElementById(
            "editEventDate"
        ).value = date;


        document.getElementById(
            "editEventType"
        ).value = type;


        modal.classList.add("show");


        document.body.style.overflow =
            "hidden";

    }


    function closeEditEventModal() {

        const modal =
            document.getElementById(
                "editEventModal"
            );


        if (modal) {

            modal.classList.remove("show");

            document.body.style.overflow =
                "";

        }

    }


    /* =========================================================
       DELETE FROM EDIT MODAL
       ========================================================= */

    function submitEditModalDelete() {

        const id =
            document.getElementById(
                "editEventId"
            ).value;


        if (!id)
            return;


        if (
            confirm(
                "Are you sure you want to delete this event?"
            )
        ) {

            document.getElementById(
                "deleteFormEventId"
            ).value = id;


            document.getElementById(
                "editModalDeleteForm"
            ).submit();

        }

    }


    /* =========================================================
       EMPLOYEE VIEW MODAL
       ========================================================= */

    function openViewEventModal(
        id,
        title,
        desc,
        date,
        type
    ) {

        const modal =
            document.getElementById(
                "viewEventModal"
            );


        if (!modal)
            return;


        document.getElementById(
            "viewEventTitle"
        ).textContent = title;


        document.getElementById(
            "viewEventDate"
        ).textContent =
            "📅 " + date;


        document.getElementById(
            "viewEventDescription"
        ).textContent =
            desc ||
            "No description provided.";


        const pill =
            document.getElementById(
                "viewEventTypePill"
            );


        if (pill) {

            pill.textContent =
                type;


            pill.className =
                "event-detail-type-pill " +
                type.toLowerCase();

        }


        modal.classList.add("show");


        document.body.style.overflow =
            "hidden";

    }


    function closeViewEventModal() {

        const modal =
            document.getElementById(
                "viewEventModal"
            );


        if (modal) {

            modal.classList.remove("show");

            document.body.style.overflow =
                "";

        }

    }


    /* =========================================================
       ESC KEY
       ========================================================= */

    document.addEventListener(
        "keydown",
        function (event) {

            if (event.key === "Escape") {

                closeAddEventModal();

                closeEditEventModal();

                closeViewEventModal();

            }

        }
    );

</script>

}